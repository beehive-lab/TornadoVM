<?xml version="1.0" encoding="UTF-8"?>
<!--
  Standalone helper POM used by bin/build_graal_module.py to relocate the frozen
  Graal compiler (org.graalvm.compiler.* to tornado.graal.compiler.*) so it can be
  vendored as a normal application module (tornado.graal) on the regular module-path,
  removing the need for the upgrade-module-path graalJars mechanism.

  It is not part of the reactor build; it is invoked out-of-band. The relocated
  classes jar it produces has no module-info (excluded here); a correct module-info
  for the tornado.graal module is generated and injected by bin/build_graal_module.py.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>tornado.graal</groupId>
    <artifactId>tornado-graal</artifactId>
    <version>23.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.graalvm.compiler</groupId>
            <artifactId>compiler</artifactId>
            <version>23.1.0</version>
        </dependency>
        <!-- Folded into tornado.graal as well, so the module has no org.graalvm.* module
             dependencies a GraalVM JDK could shadow. -->
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>word</artifactId>
            <version>23.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.sdk</groupId>
            <artifactId>collections</artifactId>
            <version>23.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.graalvm.truffle</groupId>
            <artifactId>truffle-compiler</artifactId>
            <version>23.1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Pin the default-lifecycle plugins to the same versions the reactor pins, so a CI run
                 downloads one set of plugin jars instead of two. This is an efficiency measure only.
                 It is NOT a correctness guarantee: this POM is built before the reactor, so on a clean
                 runner nothing is cached yet and every plugin it needs — including the ones left
                 unpinned here (resources, surefire) — must be downloadable. That is why the shade build
                 in bin/build_graal_module.py must not run with -o; pinning alone cannot make an offline
                 build resolvable from an empty local repository. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.2</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <artifactSet>
                                <includes>
                                    <include>org.graalvm.compiler:compiler</include>
                                    <include>org.graalvm.sdk:word</include>
                                    <include>org.graalvm.sdk:collections</include>
                                    <include>org.graalvm.truffle:truffle-compiler</include>
                                </includes>
                            </artifactSet>
                            <!-- Every org.graalvm.* package moves off the GraalVM namespaces, so tornado.graal
                                 can never split a package with, or be shadowed by, a module a GraalVM JDK
                                 bundles (jdk.internal.vm.compiler, org.graalvm.word, org.graalvm.collections,
                                 org.graalvm.truffle.compiler). word, collections and truffle-compiler are
                                 folded in rather than shipped as their own same-named modules. -->
                            <relocations>
                                <!-- The JVMCI API Graal is written against is TornadoVM's own tornado.meta
                                     module (OpenJDK 21.0.2's jdk.vm.ci.meta/code/... renamed), so point
                                     every jdk.vm.ci reference at it. jdk.vm.ci.meta becomes tornado.meta
                                     itself; every other jdk.vm.ci package keeps its sub-name. The first
                                     matching relocation wins, so the specific one goes first. References to
                                     the HotSpot-only packages (jdk.vm.ci.hotspot, .runtime, .services) are
                                     relocated too but have no target: they sit on Graal's HotSpot-JIT paths,
                                     which TornadoVM never executes. -->
                                <relocation>
                                    <pattern>jdk.vm.ci.meta</pattern>
                                    <shadedPattern>tornado.meta</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>jdk.vm.ci</pattern>
                                    <shadedPattern>tornado.meta</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.graalvm.compiler</pattern>
                                    <shadedPattern>tornado.graal.compiler</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.graalvm.graphio</pattern>
                                    <shadedPattern>tornado.graal.graphio</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.graalvm.util</pattern>
                                    <shadedPattern>tornado.graal.util</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.graalvm.word</pattern>
                                    <shadedPattern>tornado.graal.word</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.graalvm.collections</pattern>
                                    <shadedPattern>tornado.graal.collections</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.oracle.truffle.compiler</pattern>
                                    <shadedPattern>tornado.graal.truffle.compiler</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- shade cannot rewrite module-info.class; regenerated + injected downstream -->
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
