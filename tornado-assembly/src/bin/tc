#!/usr/bin/env bash
# tc: TornadoVM's kernel compiler, headless. Compiles kernel methods from class files and prints the
# CUDA C++, OpenCL C or MSL it generates; no GPU and no TornadoVM runtime are needed.
#   tc emit [--target cuda|opencl|metal] [--cc N] [--arg name=value]... [--cp PATH] (Class method | --all)
#   tc --version
# Runs the native image when `build-tc-native` has built one, the JVM otherwise. TORNADOVM_HOME
# defaults to the SDK this script is in.
set -euo pipefail
export TORNADOVM_HOME="${TORNADOVM_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
if [ -x "$TORNADOVM_HOME/bin/tc-native" ]; then
  exec "$TORNADOVM_HOME/bin/tc-native" "$@"
fi
cp=$(ls "$TORNADOVM_HOME"/share/java/tornado/tc-*.jar | tr '\n' ':')
preview=$(grep -q 'tornado.jdk.preview=true' "$TORNADOVM_HOME/etc/tornado.jdk" 2>/dev/null && echo --enable-preview || true)
exec "${JAVA_HOME:+$JAVA_HOME/bin/}java" $preview -XX:TieredStopAtLevel=1 -cp "$cp" uk.ac.manchester.tornado.tc.runtime.tools.Tc "$@"
