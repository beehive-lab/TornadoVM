import argparse
import os
import sys

try:
    TORNADO_CMD = os.environ["TORNADOVM_HOME"] + "/bin/tornado "
except KeyError:
    print("[ERROR] TORNADOVM_HOME is not defined.")
    sys.exit(1)

try:
    os.environ["JAVA_HOME"]
except KeyError:
    print("[ERROR] JAVA_HOME is not defined.")
    sys.exit(1)

RUNNER = "tornado.unittests/uk.ac.manchester.tornado.unittests.eval.InterpreterEval"


def main():
    parser = argparse.ArgumentParser(description="Time TornadoVM execute() after warmup. Same JVM flags as tornado-test.")
    parser.add_argument("workloads", nargs="*", help="workload names (default: all). See Java class for the list.")
    parser.add_argument("--jvm", "-J", dest="jvmFlags", default="", help="JVM flags, e.g. -J=-Dtornado.interpreter.native=true")
    parser.add_argument("--native", action="store_true", help="set -Dtornado.interpreter.native=true")
    args = parser.parse_args()

    jvm = "-Dtornado.recover.bailout=False "
    if args.native:
        jvm += "-Dtornado.interpreter.native=true "
    if args.jvmFlags:
        jvm += args.jvmFlags + " "

    params = " ".join(args.workloads)
    command = TORNADO_CMD + ' --jvm "' + jvm + '" -m ' + RUNNER
    if params:
        command += ' --params "' + params + '"'
    sys.exit(os.system(command))


if __name__ == "__main__":
    main()
