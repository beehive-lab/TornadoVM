<?xml version="1.0"?>
<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>bin</id>
    <formats>
        <format>dir</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>tornadovm-${project.version}-${tornado.backend}/</baseDirectory>
    <fileSets>
        <fileSet>
            <directory>../</directory>
            <!-- README file in share/tornado -->
            <includes>
                <include>README.md</include>
            </includes>
            <outputDirectory>share/tornado</outputDirectory>
            <fileMode>0444</fileMode>
        </fileSet>
        <fileSet>
            <directory>../</directory>
            <!-- License file in root directory -->
            <includes>
                <include>LICENSE_APACHE2</include>
                <include>THIRD_PARTY_NOTICES</include>
            </includes>
            <outputDirectory>./</outputDirectory>
            <fileMode>0444</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/bin</directory>
            <!-- tornado scripts -->
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.sh</include>
                <include>*.cmd</include>
                <include>*.py</include>
                <include>tornado</include>
                <include>tornado-test</include>
                <include>tc</include>
                <include>tornado-selftest</include>
                <include>build-tc-native</include>
                <include>tornado-native-image</include>
                <include>misc/*.py</include>
            </includes>
            <lineEnding>unix</lineEnding>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/bin</directory>
            <!-- Windows executables (binary files - without line ending conversion) -->
            <outputDirectory>bin</outputDirectory>
            <includes>
                <include>*.exe</include>
                <include>*.spec</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/etc</directory>
            <!-- tornado etc configuration -->
            <outputDirectory>etc</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
            <excludes>
                <exclude>tornado.backend</exclude>
                <exclude>tornado.jdk</exclude>
            </excludes>
            <filtered>true</filtered>
            <lineEnding>unix</lineEnding>
            <fileMode>0666</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/etc</directory>
            <!-- tornado.backend file (pre-created by compile script, no filtering needed) -->
            <outputDirectory>etc</outputDirectory>
            <includes>
                <include>tornado.backend</include>
                <include>tornado.jdk</include>
            </includes>
            <filtered>false</filtered>
            <lineEnding>unix</lineEnding>
            <fileMode>0666</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/etc</directory>
            <outputDirectory>./</outputDirectory>
            <includes>
                <include>README.md</include>
            </includes>
            <filtered>true</filtered>
            <lineEnding>unix</lineEnding>
            <fileMode>0777</fileMode>
        </fileSet>
        <fileSet>
            <directory>../</directory>
            <outputDirectory>./</outputDirectory>
            <includes>
                <include>CONTRIBUTING.md</include>
            </includes>
            <fileMode>0444</fileMode>
        </fileSet>
        <fileSet>
            <directory>../docs/source</directory>
            <outputDirectory>./</outputDirectory>
            <includes>
                <include>CHANGELOG.rst</include>
            </includes>
            <fileMode>0444</fileMode>
        </fileSet>
        <fileSet>
            <directory>../tornado-drivers/opencl-jni/target/windows-i386-release/cmake/Release</directory>
            <outputDirectory>./lib/</outputDirectory>
            <includes>
                <include>*.dll</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>../tornado-drivers/opencl-jni/target/windows-amd64-release/cmake/Release</directory>
            <outputDirectory>./lib/</outputDirectory>
            <includes>
                <include>*.dll</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>src/examples</directory>
            <!-- Tornado full examples copied into examples directory -->
            <outputDirectory>examples</outputDirectory>
            <includes>
                <include>**/*</include>
            </includes>
            <fileMode>0666</fileMode>
        </fileSet>
    </fileSets>
    <moduleSets>
        <moduleSet>
            <!-- Enable access to all projects in the current multimodule build! -->
            <useAllReactorProjects>true</useAllReactorProjects>
            <!-- Now, select which projects to include in this module-set. -->
            <includes>
                <include>io.github.beehive-lab:tornado-api</include>
                <include>io.github.beehive-lab:tornado-runtime</include>
                <include>io.github.beehive-lab:tornado-matrices</include>
                <include>io.github.beehive-lab:tornado-drivers-common</include>
                <include>io.github.beehive-lab:tornado-drivers-opencl</include>
                <include>io.github.beehive-lab:tornado-drivers-metal</include>
                <include>io.github.beehive-lab:tornado-cublas</include>
                <include>io.github.beehive-lab:tornado-clblast</include>
                <include>io.github.beehive-lab:tornado-curand</include>
                <include>io.github.beehive-lab:tornado-cufft</include>
                <include>io.github.beehive-lab:tornado-cudnn</include>
                <include>io.github.beehive-lab:tornado-cusparse</include>
                <include>io.github.beehive-lab:tornado-cudf</include>
                <include>io.github.beehive-lab:tornado-cutlass</include>
                <include>io.github.beehive-lab:tornado-cuvs</include>
                <include>io.github.beehive-lab:tornado-mlx</include>
                <include>io.github.beehive-lab:tornado-nccl</include>
                <include>io.github.beehive-lab:tc-selftest</include>
            </includes>
            <binaries>
                <outputDirectory>share/java/tornado</outputDirectory>
                <unpack>false</unpack>
                <dependencySets>
                    <dependencySet>
                        <!-- Dependencies come from tornado-assembly's own, which include the test and example modules and
                             JUnit: those go to share/java/tornado-misc (next module set) -->
                        <outputDirectory>share/java/tornado</outputDirectory>
                        <excludes>
                            <exclude>io.github.beehive-lab:tornado-examples</exclude>
                            <exclude>io.github.beehive-lab:tornado-unittests</exclude>
                            <exclude>org.junit.jupiter:*</exclude>
                            <exclude>org.junit.platform:*</exclude>
                            <exclude>org.opentest4j:*</exclude>
                            <exclude>org.opentest4j.reporting:*</exclude>
                            <exclude>org.apiguardian:*</exclude>
                            <exclude>org.jspecify:*</exclude>
                        </excludes>
                    </dependencySet>
                </dependencySets>
            </binaries>
        </moduleSet>
        <moduleSet>
            <!-- The test and example modules stay off the runtime module path (share/java/tornado): tornado.unittests
                 provides a TornadoLibraryProvider, so service binding from tornado.runtime would resolve it, JUnit and
                 jdk.incubator.vector in every application's boot layer (which also stops a JDK AOT cache from archiving
                 the module graph). bin/tornado adds share/java/tornado-misc only when the command runs one of them. -->
            <useAllReactorProjects>true</useAllReactorProjects>
            <includes>
                <include>io.github.beehive-lab:tornado-examples</include>
                <include>io.github.beehive-lab:tornado-unittests</include>
            </includes>
            <binaries>
                <outputDirectory>share/java/tornado-misc</outputDirectory>
                <unpack>false</unpack>
                <dependencySets>
                    <dependencySet>
                        <!-- Only JUnit and its dependencies: the TornadoVM modules are in share/java/tornado -->
                        <outputDirectory>share/java/tornado-misc</outputDirectory>
                        <includes>
                            <include>org.junit.jupiter:*</include>
                            <include>org.junit.platform:*</include>
                            <include>org.opentest4j:*</include>
                            <include>org.opentest4j.reporting:*</include>
                            <include>org.apiguardian:*</include>
                            <include>org.jspecify:*</include>
                        </includes>
                    </dependencySet>
                </dependencySets>
            </binaries>
        </moduleSet>
    </moduleSets>
    <dependencySets>
        <dependencySet>
            <outputDirectory>lib</outputDirectory>
            <unpack>true</unpack>
            <useProjectArtifact>false</useProjectArtifact>
            <useStrictFiltering>false</useStrictFiltering>
            <unpackOptions>
                <includes>
                    <include>*.dylib</include>
                    <include>*.dll</include>
                    <include>*.so</include>
                </includes>
            </unpackOptions>
            <includes>
                <include>io.github.beehive-lab:tornado-drivers-metal-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-opencl-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cuda-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cublas-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cufft-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cudnn-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cudf-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cusparse-jni:jar:libs</include>
                <include>io.github.beehive-lab:tornado-drivers-cutlass-jni:jar:libs</include>
            </includes>
        </dependencySet>
    </dependencySets>
</assembly>
