# Example Java argfile for TornadoVM (OpenCL and CUDA backends), for `java @example-argfile ...`
# invocations that don't go through the `tornado` launcher (see BUILD_AND_RUN.md,
# "Maven Build + Java with Argfile").
#
# Regenerated from a real jdk21/opencl,cuda build's `tornado --generate-argfile` output -
# do not hand-edit; the exact flags (module names, --enable-native-access) depend on the
# backends TornadoVM was built with. To refresh this file or produce one for other backends:
#   source setvars.sh && tornado --generate-argfile
# then copy $TORNADOVM_HOME/tornado-argfile.template here (it already uses the
# ${TORNADOVM_HOME} placeholder below, so it works from any checkout).
#
# Expand ${TORNADOVM_HOME} (e.g. `envsubst < example-argfile > tornado.args`), then run:
#   java @tornado.args -m <module>/<Main-Class> [app args]


-server
--enable-preview
-Djava.library.path=${TORNADOVM_HOME}/lib
--module-path .:${TORNADOVM_HOME}/share/java/tornado
-Dtornado.load.api.implementation=uk.ac.manchester.tornado.runtime.tasks.TornadoTaskGraph
-Dtornado.load.runtime.implementation=uk.ac.manchester.tornado.runtime.TornadoCoreRuntime
-Dtornado.load.tornado.implementation=uk.ac.manchester.tornado.runtime.common.Tornado
# --- inlined common-exports ---
--add-opens java.base/java.lang=tornado.runtime

--enable-native-access=tornado.runtime
# --- inlined opencl-exports ---
--add-opens java.base/java.lang=tornado.drivers.opencl

# --- inlined cuda-exports ---
--add-opens java.base/java.lang=tornado.drivers.cuda

--add-modules jdk.unsupported,java.management,java.logging,jdk.jfr,java.naming,jdk.management,tornado.runtime,tornado.drivers.common,tornado.drivers.opencl,tornado.drivers.cuda,tornado.cublas,tornado.curand,tornado.cufft,tornado.cudnn,tornado.cusparse,tornado.cutlass,tornado.cudf,tornado.cuvs
