    <properties>
        <!-- CI-friendly version: the literal default - the jdk21/jdk22plus profiles below override
             this property so `${project.version}` (and everything derived from it - the SDK
             directory/archive name, tornado.release's version= field, Maven Central coordinates)
             correctly reflects the JDK actually being built, with no committed-file mutation
             needed at build time. Flattened to a concrete version by flatten-maven-plugin below
             before install/deploy, since only THIS reactor's own POM parsing understands ${revision}.

             Release automation MUST keep every pom's <version>/<parent><version> as the literal
             ${revision} and only bump this property and the profile overrides below - via
             scripts/set-maven-version.py, never `mvn versions:set`, which rewrites ${revision} to a
             hard-coded string so every build then stamps the same JDK-less version regardless of
             the active jdkNN profile (that regression is what broke the 6.0.0 to 6.0.1-dev bump:
             the SDK's tornado-api jar lost its -jdkNN suffix and a jdk21 preview-enabled jar
             leaked into jdk22plus consumer builds). -->
        <revision>7.1.1-jdk22plus-dev</revision>
        <tornado.version>${project.version}</tornado.version>
        <!-- Java release the class files target; set by the active jdk21/jdk22plus profile. -->
        <tornado.java.release>22</tornado.java.release>
        <tornado.backend>opencl</tornado.backend>
        <graalvm.version>23.1.0</graalvm.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <classifier>${platform}</classifier>
        <cmake.download>false</cmake.download>
        <jmh.version>1.29</jmh.version>
        <tornadojmhjar.name>jmhbenchmarks</tornadojmhjar.name>
        <checkstyle.config.location>tornado-assembly/src/etc/checkstyle.xml</checkstyle.config.location>
        <!-- Tests are skipped by default (GPU unit tests need a device); override with -DskipTests=false
             to run the pure-JVM tornado-runtime unit tests. -->
        <skipTests>true</skipTests>
        <!-- Default: no extra JVM args; each jdkNN profile overrides with its module-access argLine. -->
        <tornado.test.argLine></tornado.test.argLine>
    </properties>

    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.6.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.6.3</version>
                        <configuration>
                            <!-- Use source, not the release flag: the release flag resolves modules
                                 against ct.sym, which omits the JDK-internal modules some javadoc
                                 links reach. failOnError is false so the deploy still succeeds. -->
                            <source>${tornado.java.release}</source>
                            <skip>false</skip>
                            <failOnError>false</failOnError>

                            <additionalJOptions>
                                <additionalJOption>--add-modules=ALL-SYSTEM</additionalJOption>
                                <additionalJOption>--add-modules=jdk.incubator.vector</additionalJOption>
                            </additionalJOptions>

                            <!-- Avoid breaking the build -->
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <doclint>none</doclint>

                        </configuration>

                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <skip>false</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>windows-i386-release</id>
            <activation>
                <property>
                    <name>osDetection</name>
                    <value>!false</value>
                </property>
                <os>
                    <family>windows</family>
                    <arch>x86</arch>
                </os>
            </activation>
            <properties>
                <platform>windows-i386</platform>
                <build.type>release</build.type>
                <cmake.classifier>windows-i386</cmake.classifier>
                <cmake.generator>Visual Studio 17 2022</cmake.generator>
                <cmake.config>${build.type}</cmake.config>
            </properties>
        </profile>
        <profile>
            <id>windows-amd64-release</id>
            <activation>
                <property>
                    <name>osDetection</name>
                    <value>!false</value>
                </property>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
