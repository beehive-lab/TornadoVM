        </profile>
        <profile>
            <id>portable</id>
            <!--
                  Sonatype requires a main jar, even for platform-specific artifacts, so we supply it with an
                  empty file.
                  -->
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.googlecode.cmake-maven-project</groupId>
                        <artifactId>cmake-maven-plugin</artifactId>
                        <version>3.7.0-b2</version>
                        <executions>
                            <execution>
                                <id>cmake-generate</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>cmake-compile</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
            <properties>
                <platform>portable</platform>
                <build.type>release</build.type>
                <classifier/>
            </properties>
        </profile>

        <profile>
            <id>jdk21</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <revision>5.2.1-jdk21-dev</revision>
                <!-- Runtime module access for pure-JVM unit tests (mirrors this profile's compilerArgs). -->
                <tornado.test.argLine>--enable-preview --add-modules=jdk.incubator.vector --add-modules=jdk.internal.vm.ci --add-exports jdk.internal.vm.ci/jdk.vm.ci.meta=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.code=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.common=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.runtime=ALL-UNNAMED</tornado.test.argLine>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>${skipTests}</skipTests>
                            <!-- Pure-JVM unit tests need JVMCI package access. Run on the classpath
                                 (useModulePath=false) so surefire does not ASM-parse the vendored jvmci jar's
                                 module-info (its JDK-27 class version breaks Maven's bundled parser); the argLine
                                 exports the jvmci packages to ALL-UNNAMED. Skipped by default; run with:
                                 mvn -Pjdk21 -pl tornado-runtime test -DskipTests=false -->
                            <useModulePath>false</useModulePath>
                            <argLine>${tornado.test.argLine}</argLine>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>3.3.0</version>
                        <configuration>
                            <consoleOutput>true</consoleOutput>
                            <failsOnError>true</failsOnError>
                            <linkXRef>false</linkXRef>
                        </configuration>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.11.0</version>
                        <configuration>
                            <forceJavacCompilerUse>true</forceJavacCompilerUse>
                            <source>21</source>
                            <target>21</target>
                            <showDeprecation>true</showDeprecation>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                                <arg>--add-modules</arg>
                                <arg>ALL-SYSTEM</arg>
                                <arg>--add-modules=jdk.incubator.vector</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/common-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/opencl-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/metal-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/cuda-exports</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Single target profile for every JDK from 22 upwards. FFM/Panama is final from 22,
                 so nothing here needs the enable-preview flag and the emitted class files are
                 portable: one SDK built once runs on 22, 23, 24, 25, 26, 27 and later. Replaces the
                 old jdk25/jdk26/jdk27 profiles, which differed only in the revision string and in
                 where javac found jdk.vm.ci.*.

                 Two settings do that work together:

                 "release" rather than "source"+"target". source/target still links against the
                 build JDK's platform classes, so a build on a newer JDK can bind an API absent on
                 22 and fail at run time; the release flag uses the JDK 22 signatures and rejects it
                 at compile time, which is what makes the floor a real guarantee. 22 is also the
                 ceiling imposed by frozen Graal 23.1.0, whose Classfile reader rejects class-file
                 versions newer than it knows.

                 The vendored jvmci dependency, unconditionally. The release flag hides every
                 JDK-internal module, so the platform jdk.internal.vm.ci is invisible to javac even
                 on the JDKs that still ship it, and the vendored JDK-21 module on the module path
                 supplies jdk.vm.ci.* on every build JDK alike. That is why no patch-module argument
                 and no build-JDK-specific profile are needed here: the compile is now identical
                 whether it runs on 22 or on 27. (At RUN time the platform module does still exist
                 on 22-26, which is what bin/tornado patches; that is a separate concern.) -->
            <id>jdk22plus</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <properties>
                <revision>5.2.1-jdk22plus-dev</revision>
                <!-- Runtime module access for the opt-in pure-JVM unit tests, which run under the
                     BUILD JDK; specialised below when that JDK still ships the platform module. -->
                <tornado.test.argLine>--add-modules=jdk.incubator.vector</tornado.test.argLine>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>tornado.jvmci</groupId>
                    <artifactId>jvmci</artifactId>
                    <version>21.0.2</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>${skipTests}</skipTests>
                            <!-- Pure-JVM unit tests need JVMCI package access. Run on the classpath
                                 (useModulePath=false) so surefire does not ASM-parse the vendored jvmci
                                 jar's module-info; the argLine exports the jvmci packages to
                                 ALL-UNNAMED. Skipped by default; run with:
                                 mvn -Pjdk22plus -pl tornado-runtime test -DskipTests=false -->
                            <useModulePath>false</useModulePath>
                            <argLine>${tornado.test.argLine}</argLine>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.11.0</version>
                        <configuration>
                            <forceJavacCompilerUse>true</forceJavacCompilerUse>
                            <release>22</release>
                            <showDeprecation>true</showDeprecation>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                            <compilerArgs>
                                <arg>--add-modules</arg>
                                <arg>ALL-SYSTEM</arg>
                                <arg>--add-modules=jdk.incubator.vector</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/common-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/opencl-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/metal-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/cuda-exports</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <!-- Selected by the BUILD JDK, never named by hand, and it affects only the opt-in
                 surefire tests (skipped by default), which run on this same JDK. On 22-26 the
                 platform still ships jdk.internal.vm.ci with interfaces drifted from the JDK-21
                 shape, so overlay the frozen classes at run time. On 27+ there is nothing to patch.
                 Declared after jdk22plus so its property wins. -->
            <id>jvmci-test-args-from-platform</id>
            <activation>
                <jdk>[22,27)</jdk>
            </activation>
            <properties>
                <tornado.test.argLine>--add-modules=jdk.incubator.vector --add-modules=jdk.internal.vm.ci --patch-module jdk.internal.vm.ci=${user.dir}/graalJars/jvmci-21.0.2.jar --add-exports jdk.internal.vm.ci/jdk.vm.ci.meta=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.code=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.common=ALL-UNNAMED --add-exports jdk.internal.vm.ci/jdk.vm.ci.runtime=ALL-UNNAMED</tornado.test.argLine>
            </properties>
        </profile>

        <profile>
            <id>graal-jdk-21</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.11.0</version>
                        <configuration>
                            <forceJavacCompilerUse>true</forceJavacCompilerUse>
                            <source>21</source>
                            <target>21</target>
                            <showDeprecation>true</showDeprecation>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.openjdk.jmh</groupId>
                                    <artifactId>jmh-generator-annprocess</artifactId>
                                    <version>${jmh.version}</version>
                                </path>
                            </annotationProcessorPaths>
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                                <arg>--add-modules</arg>
                                <arg>ALL-SYSTEM</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/common-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/opencl-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/metal-exports</arg>
                                <arg>@${user.dir}/tornado-assembly/src/etc/exportLists/cuda-exports</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
    <build>
        <finalName>${project.artifactId}-${project.version}-${buildNumber}</finalName>
        <plugins>
            <!-- CI-friendly versions: <revision> in <properties> above (default jdk21, overridden per
                 jdkNN profile) lets every jdk21/25/26/27 profile drive `${project.version}` without
                 ever mutating a committed pom.xml. This plugin resolves ${revision} into the concrete
                 version in the POM that actually gets installed/deployed (mvn's own in-reactor
                 resolution already understands ${revision} for module-to-module dependency wiring;
                 this is only needed for the *published* .pom file consumers see).
                 resolveCiFriendliesOnly leaves everything else in the POM untouched. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-scm-plugin</artifactId>
                <version>1.11.2</version>
                <configuration>
                    <goals>install</goals>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>assembly.xml</descriptor>
                    </descriptors>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                        </manifest>
                        <manifestEntries>
                            <Implementation-Build>${buildNumber}</Implementation-Build>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>buildnumber-maven-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>create</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <getRevisionOnlyOnce>true</getRevisionOnlyOnce>
                    <doCheck>false</doCheck>
                    <doUpdate>false</doUpdate>
                    <shortRevisionLength>7</shortRevisionLength>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.2.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>${tornadojmhjar.name}</finalName>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>org.openjdk.jmh.Main</mainClass>
                                </transformer>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <!--
                                        Shading signed JARs will fail without this.
                                        http://stackoverflow.com/questions/999489/invalid-signature-file-when-attempting-to-run-a-jar
                                    -->
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
