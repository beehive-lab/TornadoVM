            <!-- Frozen Graal 23.1.0 relocated (org.graalvm.compiler.* to
                 tornado.graal.compiler.*, with word/collections/truffle-compiler folded in)
                 into the vendored module tornado.graal by bin/build_graal_module.py, so it
                 lives on the regular module-path. -->
            <groupId>tornado.graal</groupId>
            <artifactId>tornado-graal</artifactId>
            <version>23.1.0</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>
