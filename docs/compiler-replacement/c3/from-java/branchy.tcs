kernel C3Kernels.compute(ptr<global> in, ptr<global> out) -> void {
  i32 i;
  i64 v0;
  i64 v7;
  f32 x;
  f32 v_2;
  i = tornado.thread_id.global.x();
  v0 = load<i64>(in);
  if ((i sge trunc<i32>(v0))) {
  } else {
    v7 = ((sext<i64>(i) * 4) + 16);
    x = load<f32>(ptr.offset(in, v7));
    if ((x ule 0.0)) {
      v_2 = fneg(x);
    } else {
      v_2 = (math.sqrt(x) * 2.0);
    }
    store(ptr.offset(out, v7), v_2);
  }
  return;
}
