kernel Branchy.compute(ptr<global> in, ptr<global> out) -> void {
  i32 i;
  i64 v0;
  f32 x;
  f32 r;
  f32 v;
  i = tornado.thread_id.global.x();
  v0 = load<i64>(in);
  if ((i slt trunc<i32>(v0))) {
    x = load<f32>(ptr.offset(in, ((sext<i64>(i) * 4) + 16)));
    if ((x ogt 0.0)) {
      r = math.sqrt(x);
      v = (r * 2.0);
    } else {
      v = fneg(x);
    }
    store(ptr.offset(out, ((sext<i64>(i) * 4) + 16)), v);
  }
  return;
}
