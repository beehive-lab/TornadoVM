<?xml version="1.0"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.beehive-lab</groupId>
        <artifactId>tornado-kotlin</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>tornado-kotlin-examples</artifactId>
    <name>tornado-kotlin-examples</name>
    <description>TornadoVM examples written in Kotlin</description>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>tornado-kotlin-api</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.jetbrains.kotlin</groupId>
                <artifactId>kotlin-maven-plugin</artifactId>
                <configuration>
                    <!-- Examples are compiled like user code, with kotlinc's default flags. -->
                    <args combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
