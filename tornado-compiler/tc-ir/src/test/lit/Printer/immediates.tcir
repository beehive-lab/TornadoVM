; Intrinsic immediates: typed compile-time parameters printed after the name, in key order, and
; parsed back (strings quoted, integers plain, negative integers allowed).
; RUN: tc-ir %s | FileCheck %s
; RUN: tc-ir %s | tc-ir - | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @imm(%v: vec<4 x f32>, %n: i32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = tornado.vector.lane<lane = 3>(%v) : f32
; CHECK-NEXT:    tornado.device_launch<callee = "pkg.K.child", mode = "tail">(%n)
; CHECK-NEXT:    %b = tornado.example<name = "x", offset = -8>() : f32
; CHECK-NEXT:    %c = fadd %a, %b : f32
; CHECK-NEXT:    ret %c
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @imm(%v: vec<4 x f32>, %n: i32) -> f32 {
^entry:
  %a = tornado.vector.lane<lane = 3>(%v) : f32
  tornado.device_launch<mode = "tail", callee = "pkg.K.child">(%n)
  %b = tornado.example<offset = -8, name = "x">() : f32
  %c = fadd %a, %b : f32
  ret %c
}
