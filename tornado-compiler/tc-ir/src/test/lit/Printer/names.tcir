; Names are readability hints: clashes get a .N suffix, numeric names are renumbered in order, and
; unnamed blocks get bbN labels.
; RUN: tc-ir %s | FileCheck %s

; CHECK:      ^entry:
; CHECK-NEXT:   %0 = const 1 : i32
; CHECK-NEXT:   %1 = add %0, %0 : i32
; CHECK-NEXT:   br ^loop(%1)
; CHECK-NEXT: ^loop(%i: i32):
; CHECK-NEXT:   %i.1 = add %i, %0 : i32
; CHECK-NEXT:   br ^loop(%i.1)
device @names() -> void {
^entry:
  %7 = const 1 : i32
  %42 = add %7, %7 : i32
  br ^loop(%42)
^loop(%i: i32):
  %i.1 = add %i, %7 : i32
  br ^loop(%i.1)
}
