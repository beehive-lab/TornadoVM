<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.beehive-lab</groupId>
        <artifactId>tornado</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- TC: the Graal-free TornadoVM compiler (tornado-compiler/README.md). Its modules are pure Java and
         headless, so their unit tests run on every build, unlike the GPU test suites. -->
    <artifactId>tornado-compiler</artifactId>
    <name>tornado-compiler</name>
    <packaging>pom</packaging>

    <properties>
        <skipTests>false</skipTests>
    </properties>

    <modules>
        <module>tc-check</module>
        <module>tc-ir</module>
        <module>tc-frontend</module>
        <module>tc-opt</module>
        <module>tc-lower</module>
        <module>tc-codegen</module>
        <module>tc-tornado</module>
        <module>tc-runtime</module>
        <module>tc-debug</module>
        <module>tc-selftest</module>
    </modules>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="append">
                        <!-- Cold start: string concatenation as plain StringBuilder code instead of an
                             invokedynamic site bootstrapped on first use (hundreds in the binding and
                             spelling tables); see cold-start.md in mikepapadim/tornado-compiler-spec. -->
                        <arg>-XDstringConcat=inline</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
