; Targets without wide vector accesses (Metal): a vector load or store at a byte offset of an array
; becomes one access per lane, at the array's data plus offset plus 4 bytes per lane.
; RUN: tc-tornado --abi --split-vectors %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @copy4(%a: ptr<global>, %from: i64, %to: i64) -> void {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = const 16 : i64
; CHECK-NEXT:    %a_data = ptr.offset %a, %0 : ptr<global>
; CHECK-NEXT:    %1 = ptr.offset %a_data, %from : ptr<global>
; CHECK-NEXT:    %2 = load %1 : f32
; CHECK-NEXT:    %3 = const 4 : i64
; CHECK-NEXT:    %4 = add %from, %3 : i64 [nsw]
; CHECK-NEXT:    %5 = ptr.offset %a_data, %4 : ptr<global>
; CHECK-NEXT:    %6 = load %5 : f32
; CHECK-NEXT:    %7 = const 8 : i64
; CHECK-NEXT:    %8 = add %from, %7 : i64 [nsw]
; CHECK-NEXT:    %9 = ptr.offset %a_data, %8 : ptr<global>
; CHECK-NEXT:    %10 = load %9 : f32
; CHECK-NEXT:    %11 = const 12 : i64
; CHECK-NEXT:    %12 = add %from, %11 : i64 [nsw]
; CHECK-NEXT:    %13 = ptr.offset %a_data, %12 : ptr<global>
; CHECK-NEXT:    %14 = load %13 : f32
; CHECK-NEXT:    %v = tornado.vector.make(%2, %6, %10, %14) : vec<4 x f32>
; CHECK-NEXT:    %15 = const 16 : i64
; CHECK-NEXT:    %a_data.1 = ptr.offset %a, %15 : ptr<global>
; CHECK-NEXT:    %16 = tornado.vector.lane<lane = 0>(%v) : f32
; CHECK-NEXT:    %17 = ptr.offset %a_data.1, %to : ptr<global>
; CHECK-NEXT:    store %17, %16
; CHECK-NEXT:    %18 = tornado.vector.lane<lane = 1>(%v) : f32
; CHECK-NEXT:    %19 = const 4 : i64
; CHECK-NEXT:    %20 = add %to, %19 : i64 [nsw]
; CHECK-NEXT:    %21 = ptr.offset %a_data.1, %20 : ptr<global>
; CHECK-NEXT:    store %21, %18
; CHECK-NEXT:    %22 = tornado.vector.lane<lane = 2>(%v) : f32
; CHECK-NEXT:    %23 = const 8 : i64
; CHECK-NEXT:    %24 = add %to, %23 : i64 [nsw]
; CHECK-NEXT:    %25 = ptr.offset %a_data.1, %24 : ptr<global>
; CHECK-NEXT:    store %25, %22
; CHECK-NEXT:    %26 = tornado.vector.lane<lane = 3>(%v) : f32
; CHECK-NEXT:    %27 = const 12 : i64
; CHECK-NEXT:    %28 = add %to, %27 : i64 [nsw]
; CHECK-NEXT:    %29 = ptr.offset %a_data.1, %28 : ptr<global>
; CHECK-NEXT:    store %29, %26
; CHECK-NEXT:    ret
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @copy4(%a: array<i8>, %from: i64, %to: i64) -> void {
^entry:
  %v = tornado.vector.load(%a, %from) : vec<4 x f32>
  tornado.vector.store(%a, %to, %v)
  ret
}
