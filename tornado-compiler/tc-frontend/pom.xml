<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.beehive-lab</groupId>
        <artifactId>tornado-compiler</artifactId>
        <version>${revision}</version>
    </parent>

    <!-- Java bytecode frontend: a class-file reader written from the JVM specification (and, built
         on JDK 24+, a second one over the JDK's Class-File API) and the translation of kernel
         methods into TC-SSA (SSA construction after Braun et al. 2013).
         Depends on tc-ir only; TornadoVM API types are recognised by name, not linked. Test kernels
         under src/test/kernels are compiled against tornado-api. -->
    <artifactId>tc-frontend</artifactId>
    <name>tc-frontend</name>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>tc-ir</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>tc-check</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Java kernels used as frontend test inputs; compiled with -g for local variable names. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.4.0</version>
                <executions>
                    <execution>
                        <id>add-test-kernels</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>src/test/kernels</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Built on JDK 24 or newer: also compile the Class-File API reader (src/main/java24,
             java.lang.classfile, JEP 484) with release 24 into the same classes. ClassFile loads it by
             name, only when it runs on JDK 24+, so the jar still runs on JDK 22 and 23; a build on an
             older JDK leaves it out and TC uses its own reader. -->
        <profile>
            <id>classfile-api</id>
            <activation>
                <jdk>[24,)</jdk>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <!-- javac run directly rather than a second maven-compiler-plugin execution:
                             that one would also replace this module's output directory in the reactor.
                             Its own output directory keeps javac out of module mode (target/classes
                             holds module-info.class); the classes are then copied into target/classes. -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-classfile-api</id>
                                <phase>compile</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/javac</executable>
                                    <arguments>
                                        <argument>--release</argument>
                                        <argument>24</argument>
                                        <argument>-g</argument>
                                        <argument>-encoding</argument>
                                        <argument>UTF-8</argument>
                                        <argument>-XDstringConcat=inline</argument>
                                        <argument>-classpath</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>-d</argument>
                                        <argument>${project.build.directory}/classes-java24</argument>
                                        <argument>${project.basedir}/src/main/java24/uk/ac/manchester/tornado/tc/frontend/classfile/JdkClassFileReader.java</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>add-classfile-api-classes</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}/classes-java24</directory>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
