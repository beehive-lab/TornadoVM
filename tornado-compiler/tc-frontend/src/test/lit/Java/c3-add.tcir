; CHECK-LABEL: kernel @C3Kernels.add(%ctx: obj<uk.ac.manchester.tornado.api.KernelContext>, %a: array<f32>, %b: array<f32>, %c: array<f32>) -> void {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    br ^bci0
; CHECK-NEXT:  ^bci0:
; CHECK-NEXT:    %i = tornado.thread_id.global<dim = 0>() : i32
; CHECK-NEXT:    br ^bci9(%i)
; CHECK-NEXT:  ^bci9(%i.1: i32):
; CHECK-NEXT:    %0 = array.length %a : i32
; CHECK-NEXT:    %1 = icmp.sge %i.1, %0 : i1
; CHECK-NEXT:    cond_br %1, ^bci52, ^bci18
; CHECK-NEXT:  ^bci18:
; CHECK-NEXT:    %2 = array.load %a[%i.1] : f32
; CHECK-NEXT:    %3 = array.load %b[%i.1] : f32
; CHECK-NEXT:    %4 = fadd %2, %3 : f32
; CHECK-NEXT:    array.store %c[%i.1], %4
; CHECK-NEXT:    %5 = tornado.global_size<dim = 0>() : i32
; CHECK-NEXT:    %i.2 = add %i.1, %5 : i32
; CHECK-NEXT:    br ^bci9(%i.2)
; CHECK-NEXT:  ^bci52:
; CHECK-NEXT:    ret
; CHECK-NEXT:  }
