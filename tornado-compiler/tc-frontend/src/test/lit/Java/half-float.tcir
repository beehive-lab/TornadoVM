; HalfFloat is a value type: `new HalfFloat(float)` is ftrunc to f16, `new HalfFloat(short)` a bitcast,
; getFloat32() fext, getHalfFloatValue() the raw bits; mult computes in f32 and rounds once, as Java does.
; long indices and getSizeLong() stay i64.
; RUN: tc-java --no-loc target/test-classes uk.ac.manchester.tornado.tc.frontend.kernels.HalfKernels.scale | FileCheck %s
; RUN: tc-java --no-loc target/test-classes uk.ac.manchester.tornado.tc.frontend.kernels.HalfKernels.bits | FileCheck %s --check-prefix=BITS
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: kernel @HalfKernels.scale(%a: array<f16>, %out: array<f32>, %k: f32) -> void {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    br ^bci0
; CHECK-NEXT:  ^bci0:
; CHECK-NEXT:    %i = const 0 : i32
; CHECK-NEXT:    br ^bci2(%i)
; CHECK-NEXT:  ^bci2(%i.1: i32) [parallel(iv=0)]:
; CHECK-NEXT:    %0 = array.length %a : i32
; CHECK-NEXT:    %1 = icmp.sge %i.1, %0 : i1
; CHECK-NEXT:    cond_br %1, ^bci44, ^bci10
; CHECK-NEXT:  ^bci10:
; CHECK-NEXT:    %2 = array.load %a[%i.1] : f16
; CHECK-NEXT:    %3 = ftrunc %k : f16
; CHECK-NEXT:    %4 = fext %2 : f32
; CHECK-NEXT:    %5 = fext %3 : f32
; CHECK-NEXT:    %6 = fmul %4, %5 : f32
; CHECK-NEXT:    %h = ftrunc %6 : f16
; CHECK-NEXT:    %7 = fext %h : f32
; CHECK-NEXT:    array.store %out[%i.1], %7
; CHECK-NEXT:    %8 = const 1 : i32
; CHECK-NEXT:    %i.2 = add %i.1, %8 : i32
; CHECK-NEXT:    br ^bci2(%i.2)
; CHECK-NEXT:  ^bci44:
; CHECK-NEXT:    ret
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

; BITS-LABEL: kernel @HalfKernels.bits(%in: array<i16>, %out: array<f16>, %back: array<i16>) -> void {
; BITS:         %0 = array.length %in : i64
; BITS:         %h = bitcast %{{[0-9]+}} : f16
; BITS-NEXT:    array.store %out[%i.1], %h
; BITS-NEXT:    %{{[0-9]+}} = bitcast %h : i16
