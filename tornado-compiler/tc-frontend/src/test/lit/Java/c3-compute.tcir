; CHECK-NEXT:    %2 = const 0.0 : f32
; CHECK-NEXT:    %3 = fcmp.ule %x, %2 : i1
; CHECK-NEXT:    cond_br %3, ^bci42, ^bci30
; CHECK-NEXT:  ^bci30:
; CHECK-NEXT:    %4 = math.sqrt(%x) : f32
; CHECK-NEXT:    %5 = const 2.0 : f32
; CHECK-NEXT:    %v = fmul %4, %5 : f32
; CHECK-NEXT:    br ^bci47(%v)
; CHECK-NEXT:  ^bci42:
; CHECK-NEXT:    %v.1 = fneg %x : f32
; CHECK-NEXT:    br ^bci47(%v.1)
; CHECK-NEXT:  ^bci47(%v.2: f32):
; CHECK-NEXT:    array.store %out[%i], %v.2
