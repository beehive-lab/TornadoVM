; Math calls bind to math intrinsics.
; RUN: tc-java --no-loc target/test-classes uk.ac.manchester.tornado.tc.frontend.kernels.Scalars.math | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: kernel @Scalars.math(%x: f64, %y: f32) -> f64 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    br ^bci0
; CHECK-NEXT:  ^bci0:
; CHECK-NEXT:    %0 = math.sqrt(%x) : f64
; CHECK-NEXT:    %1 = math.abs(%y) : f32
; CHECK-NEXT:    %2 = fext %1 : f64
; CHECK-NEXT:    %3 = fadd %0, %2 : f64
; CHECK-NEXT:    %4 = const 2.0 : f64
; CHECK-NEXT:    %5 = math.min(%x, %4) : f64
; CHECK-NEXT:    %6 = fadd %3, %5 : f64
; CHECK-NEXT:    ret %6
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
