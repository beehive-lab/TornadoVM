; Full unroll (O9) counts trips with the induction variable wrapping at its own width, as Java does
; (TC-2): `for (int i = 0; i < 2000000000; i += 1500000000)` runs 10 times (i turns negative at the
; third step), not 2. A loop whose wrapped variable keeps it inside for more than 64 trips stays a loop,
; for int and for long.
; RUN: tc-opt --passes=unroll,canonicalize,cfg-simplify,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @intWraps() -> i32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %cnt1 = const 10 : i32
; CHECK-NEXT:    ret %cnt1
; CHECK-NEXT:  }
; CHECK-LABEL: device @intNearMax() -> i32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %init = const 2147483640 : i32
; CHECK-NEXT:    %zero = const 0 : i32
; CHECK-NEXT:    br ^head(%init, %zero)
; CHECK-NEXT:  ^head(%i: i32, %cnt: i32):
; CHECK-NEXT:    %bound = const 2147483647 : i32
; CHECK-NEXT:    %c = icmp.slt %i, %bound : i1
; CHECK-NEXT:    cond_br %c, ^body, ^exit
; CHECK-NEXT:  ^body:
; CHECK-NEXT:    %one = const 1 : i32
; CHECK-NEXT:    %cnt1 = add %cnt, %one : i32
; CHECK-NEXT:    %step = const 3 : i32
; CHECK-NEXT:    %i1 = add %i, %step : i32
; CHECK-NEXT:    br ^head(%i1, %cnt1)
; CHECK-NEXT:  ^exit:
; CHECK-NEXT:    ret %cnt
; CHECK-NEXT:  }
; CHECK-LABEL: device @longNearMax() -> i64 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %init = const 9223372036854775000 : i64
; CHECK-NEXT:    %zero = const 0 : i64
; CHECK-NEXT:    br ^head(%init, %zero)
; CHECK-NEXT:  ^head(%i: i64, %cnt: i64):
; CHECK-NEXT:    %bound = const 9223372036854775807 : i64
; CHECK-NEXT:    %c = icmp.slt %i, %bound : i1
; CHECK-NEXT:    cond_br %c, ^body, ^exit
; CHECK-NEXT:  ^body:
; CHECK-NEXT:    %one = const 1 : i64
; CHECK-NEXT:    %cnt1 = add %cnt, %one : i64
; CHECK-NEXT:    %step = const 500 : i64
; CHECK-NEXT:    %i1 = add %i, %step : i64
; CHECK-NEXT:    br ^head(%i1, %cnt1)
; CHECK-NEXT:  ^exit:
; CHECK-NEXT:    ret %cnt
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @intWraps() -> i32 {
^entry:
  %zero = const 0 : i32
  br ^head(%zero, %zero)
^head(%i: i32, %cnt: i32):
  %bound = const 2000000000 : i32
  %c = icmp.slt %i, %bound : i1
  cond_br %c, ^body, ^exit
^body:
  %one = const 1 : i32
  %cnt1 = add %cnt, %one : i32
  %step = const 1500000000 : i32
  %i1 = add %i, %step : i32
  br ^head(%i1, %cnt1)
^exit:
  ret %cnt
}

device @intNearMax() -> i32 {
^entry:
  %init = const 2147483640 : i32
  %zero = const 0 : i32
  br ^head(%init, %zero)
^head(%i: i32, %cnt: i32):
  %bound = const 2147483647 : i32
  %c = icmp.slt %i, %bound : i1
  cond_br %c, ^body, ^exit
^body:
  %one = const 1 : i32
  %cnt1 = add %cnt, %one : i32
  %step = const 3 : i32
  %i1 = add %i, %step : i32
  br ^head(%i1, %cnt1)
^exit:
  ret %cnt
}

device @longNearMax() -> i64 {
^entry:
  %init = const 9223372036854775000 : i64
  %zero = const 0 : i64
  br ^head(%init, %zero)
^head(%i: i64, %cnt: i64):
  %bound = const 9223372036854775807 : i64
  %c = icmp.slt %i, %bound : i1
  cond_br %c, ^body, ^exit
^body:
  %one = const 1 : i64
  %cnt1 = add %cnt, %one : i64
  %step = const 500 : i64
  %i1 = add %i, %step : i64
  br ^head(%i1, %cnt1)
^exit:
  ret %cnt
}
