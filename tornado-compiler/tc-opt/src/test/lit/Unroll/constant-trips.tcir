; Full unroll (O9): a loop with a constant start, step and bound and no nested control flow becomes
; its iterations in one block, so the private array is indexed by constants (registers in nvcc).
; Loops with an unknown bound, or more than 64 trips (1024 instructions unrolled; 4096 when the loop
; touches a private array), stay.
; RUN: tc-opt --passes=unroll,canonicalize,cfg-simplify,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @three(%a: ptr<private>, %x: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %acc0 = const 0.0 : f32
; CHECK-NEXT:    %v = load %a : f32
; CHECK-NEXT:    %s = fmul %v, %x : f32
; CHECK-NEXT:    %acc.1 = fadd %acc0, %s : f32
; CHECK-NEXT:    %off = const 4 : i64
; CHECK-NEXT:    %p = ptr.offset %a, %off : ptr<private>
; CHECK-NEXT:    %v.1 = load %p : f32
; CHECK-NEXT:    %s.1 = fmul %v.1, %x : f32
; CHECK-NEXT:    %acc.1.1 = fadd %acc.1, %s.1 : f32
; CHECK-NEXT:    %off.1 = const 8 : i64
; CHECK-NEXT:    %p.1 = ptr.offset %a, %off.1 : ptr<private>
; CHECK-NEXT:    %v.2 = load %p.1 : f32
; CHECK-NEXT:    %s.2 = fmul %v.2, %x : f32
; CHECK-NEXT:    %acc.1.2 = fadd %acc.1.1, %s.2 : f32
; CHECK-NEXT:    ret %acc.1.2
; CHECK-NEXT:  }
; CHECK-LABEL: device @unknown(%n: i32) -> i32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %zero = const 0 : i32
; CHECK-NEXT:    br ^head(%zero)
; CHECK-NEXT:  ^head(%k: i32):
; CHECK-NEXT:    %more = icmp.slt %k, %n : i1
; CHECK-NEXT:    cond_br %more, ^body, ^exit
; CHECK-NEXT:  ^body:
; CHECK-NEXT:    %one = const 1 : i32
; CHECK-NEXT:    %k.1 = add %k, %one : i32
; CHECK-NEXT:    br ^head(%k.1)
; CHECK-NEXT:  ^exit:
; CHECK-NEXT:    ret %k
; CHECK-NEXT:  }
; CHECK-LABEL: device @many() -> i32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %zero = const 0 : i32
; CHECK-NEXT:    br ^head(%zero)
; CHECK-NEXT:  ^head(%k: i32):
; CHECK-NEXT:    %limit = const 65 : i32
; CHECK-NEXT:    %more = icmp.slt %k, %limit : i1
; CHECK-NEXT:    cond_br %more, ^body, ^exit
; CHECK-NEXT:  ^body:
; CHECK-NEXT:    %one = const 1 : i32
; CHECK-NEXT:    %k.1 = add %k, %one : i32
; CHECK-NEXT:    br ^head(%k.1)
; CHECK-NEXT:  ^exit:
; CHECK-NEXT:    ret %k
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @three(%a: ptr<private>, %x: f32) -> f32 {
^entry:
  %zero = const 0 : i32
  %acc0 = const 0.0 : f32
  br ^head(%zero, %acc0)
^head(%k: i32, %acc: f32):
  %three = const 3 : i32
  %more = icmp.slt %k, %three : i1
  cond_br %more, ^body, ^exit
^body:
  %four = const 4 : i64
  %w = sext %k : i64
  %off = mul %w, %four : i64
  %p = ptr.offset %a, %off : ptr<private>
  %v = load %p : f32
  %s = fmul %v, %x : f32
  %acc.1 = fadd %acc, %s : f32
  %one = const 1 : i32
  %k.1 = add %k, %one : i32
  br ^head(%k.1, %acc.1)
^exit:
  ret %acc
}

device @unknown(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  br ^head(%zero)
^head(%k: i32):
  %more = icmp.slt %k, %n : i1
  cond_br %more, ^body, ^exit
^body:
  %one = const 1 : i32
  %k.1 = add %k, %one : i32
  br ^head(%k.1)
^exit:
  ret %k
}

device @many() -> i32 {
^entry:
  %zero = const 0 : i32
  br ^head(%zero)
^head(%k: i32):
  %limit = const 65 : i32
  %more = icmp.slt %k, %limit : i1
  cond_br %more, ^body, ^exit
^body:
  %one = const 1 : i32
  %k.1 = add %k, %one : i32
  br ^head(%k.1)
^exit:
  ret %k
}
