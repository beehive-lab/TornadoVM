device @stepOne(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  br ^head(%zero)
^head(%i: i32):
  %done = icmp.sge %i, %n : i1
  cond_br %done, ^exit, ^body
^body:
  %one = const 1 : i32
  %next = add %i, %one : i32
  br ^head(%next)
^exit:
  ret %i
}

