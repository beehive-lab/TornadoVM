; FMA rematerialisation (CUDA, math optimisations on): a multiply whose every use is an add or a
; subtract is recomputed at each use, so NVRTC fuses each pair into one multiply-add. A product with
; any other use is shared as before.
; RUN: tc-opt --passes=fma-remat --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @julia(%zx: f32, %zy: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %c = const -0.7 : f32
; CHECK-NEXT:    %yy = fmul %zy, %zy : f32
; CHECK-NEXT:    %r2 = math.fma(%zx, %zx, %yy) : f32
; CHECK-NEXT:    %0 = fmul %zx, %zx : f32
; CHECK-NEXT:    %1 = fmul %zy, %zy : f32
; CHECK-NEXT:    %d = fsub %0, %1 : f32
; CHECK-NEXT:    %t = fadd %d, %c : f32
; CHECK-NEXT:    %s = fadd %r2, %t : f32
; CHECK-NEXT:    ret %s
; CHECK-NEXT:  }
; CHECK-LABEL: device @kept(%a: f32, %b: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %p = fmul %a, %b : f32
; CHECK-NEXT:    %q = fadd %p, %a : f32
; CHECK-NEXT:    %r = fdiv %p, %b : f32
; CHECK-NEXT:    %s = fadd %q, %r : f32
; CHECK-NEXT:    ret %s
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @julia(%zx: f32, %zy: f32) -> f32 {
^entry:
  %c = const -0.7 : f32
  %xx = fmul %zx, %zx : f32
  %yy = fmul %zy, %zy : f32
  %r2 = fadd %xx, %yy : f32
  %d = fsub %xx, %yy : f32
  %t = fadd %d, %c : f32
  %s = fadd %r2, %t : f32
  ret %s
}

device @kept(%a: f32, %b: f32) -> f32 {
^entry:
  %p = fmul %a, %b : f32
  %q = fadd %p, %a : f32
  %r = fdiv %p, %b : f32
  %s = fadd %q, %r : f32
  ret %s
}
