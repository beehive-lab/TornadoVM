; Float arithmetic written in double (java.lang.Math takes doubles) runs in float when that is exact:
; one +, -, *, /, sqrt, floor, ceil, rint, abs or negation of widened floats, and comparisons of them.
; A constant that is not exactly a float, and a nested operation, stay in double.
; RUN: tc-opt --passes=float-narrowing,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @narrowed(%a: f32, %b: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %f = fadd %a, %b : f32
; CHECK-NEXT:    %g = math.sqrt(%a) : f32
; CHECK-NEXT:    %0 = const 0.5 : f32
; CHECK-NEXT:    %h = fmul %a, %0 : f32
; CHECK-NEXT:    %r1 = fadd %f, %g : f32
; CHECK-NEXT:    %r2 = fadd %r1, %h : f32
; CHECK-NEXT:    ret %r2
; CHECK-NEXT:  }
; CHECK-LABEL: device @compared(%a: f32, %b: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %lt = fcmp.olt %a, %b : i1
; CHECK-NEXT:    ret %lt
; CHECK-NEXT:  }
; CHECK-LABEL: device @kept(%a: f32, %b: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %x = fext %a : f64
; CHECK-NEXT:    %y = fext %b : f64
; CHECK-NEXT:    %tenth = const 0.1 : f64
; CHECK-NEXT:    %m = fmul %x, %tenth : f64
; CHECK-NEXT:    %p = fmul %x, %y : f64
; CHECK-NEXT:    %s = fadd %p, %y : f64
; CHECK-NEXT:    %e = math.sin(%x) : f64
; CHECK-NEXT:    %f = ftrunc %m : f32
; CHECK-NEXT:    %g = ftrunc %s : f32
; CHECK-NEXT:    %h = ftrunc %e : f32
; CHECK-NEXT:    %r1 = fadd %f, %g : f32
; CHECK-NEXT:    %r2 = fadd %r1, %h : f32
; CHECK-NEXT:    ret %r2
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @narrowed(%a: f32, %b: f32) -> f32 {
^entry:
  %x = fext %a : f64
  %y = fext %b : f64
  %s = fadd %x, %y : f64
  %f = ftrunc %s : f32
  %q = math.sqrt(%x) : f64
  %g = ftrunc %q : f32
  %half = const 0.5 : f64
  %m = fmul %x, %half : f64
  %h = ftrunc %m : f32
  %r1 = fadd %f, %g : f32
  %r2 = fadd %r1, %h : f32
  ret %r2
}

device @compared(%a: f32, %b: f32) -> i1 {
^entry:
  %x = fext %a : f64
  %y = fext %b : f64
  %lt = fcmp.olt %x, %y : i1
  ret %lt
}

device @kept(%a: f32, %b: f32) -> f32 {
^entry:
  %x = fext %a : f64
  %y = fext %b : f64
  %tenth = const 0.1 : f64
  %m = fmul %x, %tenth : f64
  %p = fmul %x, %y : f64
  %s = fadd %p, %y : f64
  %e = math.sin(%x) : f64
  %f = ftrunc %m : f32
  %g = ftrunc %s : f32
  %h = ftrunc %e : f32
  %r1 = fadd %f, %g : f32
  %r2 = fadd %r1, %h : f32
  ret %r2
}
