; Half sums, differences and products computed through float and rounded back (Java's HalfFloat)
; become half operations: for +, - and * of two halves the double rounding is innocuous, so the bits
; are the same. Division keeps the float path, and so does a product with a float that is not a half.
; RUN: tc-opt --passes=native-half --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @mul_add(%a: f16, %b: f16, %c: f16) -> f16 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = fmul %a, %b : f16
; CHECK-NEXT:    %1 = fadd %0, %c : f16
; CHECK-NEXT:    ret %1
; CHECK-NEXT:  }
; CHECK-LABEL: device @sub(%a: f16, %b: f16) -> f16 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = fsub %a, %b : f16
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @div_stays(%a: f16, %b: f16) -> f16 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = fext %a : f32
; CHECK-NEXT:    %1 = fext %b : f32
; CHECK-NEXT:    %2 = fdiv %0, %1 : f32
; CHECK-NEXT:    %3 = ftrunc %2 : f16
; CHECK-NEXT:    ret %3
; CHECK-NEXT:  }
; CHECK-LABEL: device @float_operand_stays(%a: f16, %x: f32) -> f16 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = fext %a : f32
; CHECK-NEXT:    %1 = fmul %0, %x : f32
; CHECK-NEXT:    %2 = ftrunc %1 : f16
; CHECK-NEXT:    ret %2
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @mul_add(%a: f16, %b: f16, %c: f16) -> f16 {
^entry:
  %0 = fext %a : f32
  %1 = fext %b : f32
  %2 = fmul %0, %1 : f32
  %3 = ftrunc %2 : f16
  %4 = fext %3 : f32
  %5 = fext %c : f32
  %6 = fadd %4, %5 : f32
  %7 = ftrunc %6 : f16
  ret %7
}

device @sub(%a: f16, %b: f16) -> f16 {
^entry:
  %0 = fext %a : f32
  %1 = fext %b : f32
  %2 = fsub %0, %1 : f32
  %3 = ftrunc %2 : f16
  ret %3
}

device @div_stays(%a: f16, %b: f16) -> f16 {
^entry:
  %0 = fext %a : f32
  %1 = fext %b : f32
  %2 = fdiv %0, %1 : f32
  %3 = ftrunc %2 : f16
  ret %3
}

device @float_operand_stays(%a: f16, %x: f32) -> f16 {
^entry:
  %0 = fext %a : f32
  %1 = fmul %0, %x : f32
  %2 = ftrunc %1 : f16
  ret %2
}
