; Math optimisations (under tornado.enable.mathOptimizations as on the Graal path): 1 / sqrt(x)
; becomes rsqrt(x). Any other numerator, or a square root used elsewhere too, keeps its IEEE form.
; RUN: tc-opt --passes=math-peepholes,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @inv(%x: f32, %y: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %two = const 2.0 : f32
; CHECK-NEXT:    %r = math.rsqrt(%x) : f32
; CHECK-NEXT:    %t = math.sqrt(%y) : f32
; CHECK-NEXT:    %q = fdiv %two, %t : f32
; CHECK-NEXT:    %sum = fadd %r, %q : f32
; CHECK-NEXT:    ret %sum
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @inv(%x: f32, %y: f32) -> f32 {
^entry:
  %one = const 1.0 : f32
  %two = const 2.0 : f32
  %s = math.sqrt(%x) : f32
  %r = fdiv %one, %s : f32
  %t = math.sqrt(%y) : f32
  %q = fdiv %two, %t : f32
  %sum = fadd %r, %q : f32
  ret %sum
}
