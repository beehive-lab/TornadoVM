; Vectors built lane by lane: inserts that set every lane are the vector of those lanes
; (`new Float2()` then setX, setY is make_float2(x, y)); later inserts of a lane win, and lanes not
; inserted come from a vector made at the chain's root. A lane read of a made vector, or of an insert
; of that lane, is the lane's value; inserts of other lanes are looked through, down to the vector they started from.
; RUN: tc-opt --passes=canonicalize,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @lanes(%a: f32, %b: f32, %c: f32, %p: vec<2 x f32>) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %kept = tornado.vector.lane.0(%p) : f32
; CHECK-NEXT:    %s = fadd %c, %b : f32
; CHECK-NEXT:    %t = fadd %s, %kept : f32
; CHECK-NEXT:    ret %t
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @lanes(%a: f32, %b: f32, %c: f32, %p: vec<2 x f32>) -> f32 {
^entry:
  %zero = const 0.0 : f32
  %z = tornado.vector.make(%zero, %zero) : vec<2 x f32>
  %x = tornado.vector.insert.0(%z, %a) : vec<2 x f32>
  %xy = tornado.vector.insert.1(%x, %b) : vec<2 x f32>
  %again = tornado.vector.insert.0(%xy, %c) : vec<2 x f32>
  %l0 = tornado.vector.lane.0(%again) : f32
  %l1 = tornado.vector.lane.1(%again) : f32
  %partial = tornado.vector.insert.1(%p, %a) : vec<2 x f32>
  %kept = tornado.vector.lane.0(%partial) : f32
  %s = fadd %l0, %l1 : f32
  %t = fadd %s, %kept : f32
  ret %t
}
