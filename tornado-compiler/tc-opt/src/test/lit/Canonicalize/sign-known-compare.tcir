; A comparison of a value whose sign is known up to NaN (abs, sqrt, x * x, sums and products of such
; values, negations) with a constant on the other side of zero is decided except for NaN:
; abs(x) > -1 is "x is not NaN" (fcmp.ord), abs(x) < -1 is false, and the unordered forms are true or
; "x is NaN". TC rewrites them itself so the device compiler has nothing to fold: NVIDIA's PTX
; assembler folds fabsf(x) > -1.0f and x * x > -1.0f to true, losing the NaN case.
; Comparisons that depend on the value (abs(x) > 0, x > -1 for unknown x) stay.
; RUN: tc-opt --passes=canonicalize,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @absGreaterNegative(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %0 = fcmp.ord %a, %a : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @absMinGreaterNegative(%f: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %mn = math.min(%f, %f) : f32
; CHECK-NEXT:    %a = math.abs(%mn) : f32
; CHECK-NEXT:    %0 = fcmp.ord %a, %a : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @squareAtLeastZero(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %s = fmul %x, %x : f32
; CHECK-NEXT:    %0 = fcmp.ord %s, %s : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @constantOnLeft(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %0 = fcmp.ord %a, %a : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @negatedAbsBelowOne(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %n = fneg %a : f32
; CHECK-NEXT:    %0 = fcmp.ord %n, %n : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @sumOfSquaresBelowNegative(%x: f32, %y: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %r = const 0 : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @unorderedGreater(%x: f64) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %r = const 1 : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @unorderedLessIsNaN(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %0 = fcmp.uno %a, %a : i1
; CHECK-NEXT:    ret %0
; CHECK-NEXT:  }
; CHECK-LABEL: device @absGreaterZeroStays(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %z = const 0.0 : f32
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %r = fcmp.ogt %a, %z : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @unknownSignStays(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %m = const -1.0 : f32
; CHECK-NEXT:    %r = fcmp.ogt %x, %m : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @intAbsStays(%x: i32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %m = const -1 : i32
; CHECK-NEXT:    %a = math.abs(%x) : i32
; CHECK-NEXT:    %r = icmp.sgt %a, %m : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @absGreaterNegative(%x: f32) -> i1 {
^entry:
  %m = const -1.0 : f32
  %a = math.abs(%x) : f32
  %r = fcmp.ogt %a, %m : i1
  ret %r
}

device @absMinGreaterNegative(%f: f32) -> i1 {
^entry:
  %m = const -1.0 : f32
  %mn = math.min(%f, %f) : f32
  %a = math.abs(%mn) : f32
  %r = fcmp.ogt %a, %m : i1
  ret %r
}

device @squareAtLeastZero(%x: f32) -> i1 {
^entry:
  %z = const 0.0 : f32
  %s = fmul %x, %x : f32
  %r = fcmp.oge %s, %z : i1
  ret %r
}

device @constantOnLeft(%x: f32) -> i1 {
^entry:
  %m = const -1.0 : f32
  %a = math.abs(%x) : f32
  %r = fcmp.olt %m, %a : i1
  ret %r
}

device @negatedAbsBelowOne(%x: f32) -> i1 {
^entry:
  %one = const 1.0 : f32
  %a = math.abs(%x) : f32
  %n = fneg %a : f32
  %r = fcmp.olt %n, %one : i1
  ret %r
}

device @sumOfSquaresBelowNegative(%x: f32, %y: f32) -> i1 {
^entry:
  %m = const -4.0 : f32
  %xx = fmul %x, %x : f32
  %yy = fmul %y, %y : f32
  %s = fadd %xx, %yy : f32
  %r = fcmp.olt %s, %m : i1
  ret %r
}

device @unorderedGreater(%x: f64) -> i1 {
^entry:
  %m = const -1.0 : f64
  %a = math.sqrt(%x) : f64
  %r = fcmp.ugt %a, %m : i1
  ret %r
}

device @unorderedLessIsNaN(%x: f32) -> i1 {
^entry:
  %m = const -1.0 : f32
  %a = math.abs(%x) : f32
  %r = fcmp.ult %a, %m : i1
  ret %r
}

device @absGreaterZeroStays(%x: f32) -> i1 {
^entry:
  %z = const 0.0 : f32
  %a = math.abs(%x) : f32
  %r = fcmp.ogt %a, %z : i1
  ret %r
}

device @unknownSignStays(%x: f32) -> i1 {
^entry:
  %m = const -1.0 : f32
  %r = fcmp.ogt %x, %m : i1
  ret %r
}

device @intAbsStays(%x: i32) -> i1 {
^entry:
  %m = const -1 : i32
  %a = math.abs(%x) : i32
  %r = icmp.sgt %a, %m : i1
  ret %r
}
