; A division by a power of two whose reciprocal is a normal number is a multiply by that reciprocal:
; both round the same real number, so they agree for every input (NaN, infinities and overflow
; included). Other divisors, and powers of two whose reciprocal is not normal, stay divisions.
; RUN: tc-opt --passes=canonicalize,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @float(%x: f32) -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %half = const 0.5 : f32
; CHECK-NEXT:    %0 = const 2.0 : f32
; CHECK-NEXT:    %a = fmul %x, %0 : f32
; CHECK-NEXT:    %1 = const -0.25 : f32
; CHECK-NEXT:    %b = fmul %a, %1 : f32
; CHECK-NEXT:    %three = const 3.0 : f32
; CHECK-NEXT:    %c = fdiv %b, %three : f32
; CHECK-NEXT:    %big = const 1.7014118E38 : f32
; CHECK-NEXT:    %d = fdiv %c, %big : f32
; CHECK-NEXT:    %2 = const 1.1754944E-38 : f32
; CHECK-NEXT:    %e = fmul %d, %2 : f32
; CHECK-NEXT:    %f = fdiv %half, %x : f32
; CHECK-NEXT:    %g = fadd %e, %f : f32
; CHECK-NEXT:    ret %g
; CHECK-NEXT:  }
; CHECK-LABEL: device @double(%x: f64) -> f64 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = const 8.0 : f64
; CHECK-NEXT:    %a = fmul %x, %0 : f64
; CHECK-NEXT:    %1 = const 4.49423283715579E307 : f64
; CHECK-NEXT:    %b = fmul %a, %1 : f64
; CHECK-NEXT:    %sub = const 1.1125369292536007E-308 : f64
; CHECK-NEXT:    %c = fdiv %b, %sub : f64
; CHECK-NEXT:    ret %c
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @float(%x: f32) -> f32 {
^entry:
  %half = const 0.5 : f32
  %a = fdiv %x, %half : f32
  %m4 = const -4.0 : f32
  %b = fdiv %a, %m4 : f32
  %three = const 3.0 : f32
  %c = fdiv %b, %three : f32
  %big = const 1.7014118346046923e38 : f32
  %d = fdiv %c, %big : f32
  %ok = const 8.507059173023462e37 : f32
  %e = fdiv %d, %ok : f32
  %f = fdiv %half, %x : f32
  %g = fadd %e, %f : f32
  ret %g
}

device @double(%x: f64) -> f64 {
^entry:
  %eighth = const 0.125 : f64
  %a = fdiv %x, %eighth : f64
  %tiny = const 2.2250738585072014e-308 : f64
  %b = fdiv %a, %tiny : f64
  %sub = const 1.1125369292536007e-308 : f64
  %c = fdiv %b, %sub : f64
  ret %c
}
