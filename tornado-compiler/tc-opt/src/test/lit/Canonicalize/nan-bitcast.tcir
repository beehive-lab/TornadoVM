; A bit cast of an integer constant folds to a float constant unless the result is a NaN: float
; constants are carried as doubles, and widening a signalling NaN quietens it (TC-9: 0x7f800001
; became 0x7fc00001). The NaN stays a bit cast of its bits; 1.0f (0x3f800000) still folds.
; RUN: tc-opt --passes=canonicalize --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @bits() -> f32 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %s = const 2139095041 : i32
; CHECK-NEXT:    %f = bitcast %s : f32
; CHECK-NEXT:    %one = const 1065353216 : i32
; CHECK-NEXT:    %g = const 1.0 : f32
; CHECK-NEXT:    %r = fadd %f, %g : f32
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @dbits() -> f64 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %s = const 9218868437227405313 : i64
; CHECK-NEXT:    %f = bitcast %s : f64
; CHECK-NEXT:    ret %f
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @bits() -> f32 {
^entry:
  %s = const 2139095041 : i32
  %f = bitcast %s : f32
  %one = const 1065353216 : i32
  %g = bitcast %one : f32
  %r = fadd %f, %g : f32
  ret %r
}

device @dbits() -> f64 {
^entry:
  %s = const 9218868437227405313 : i64
  %f = bitcast %s : f64
  ret %f
}
