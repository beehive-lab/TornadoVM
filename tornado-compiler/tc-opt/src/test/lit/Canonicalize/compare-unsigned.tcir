; Integer.compareUnsigned and Long.compareUnsigned compare x + MIN with y + MIN (signed). That is
; the unsigned comparison of x and y, and comparing x and y directly also keeps the device compiler
; from folding the overflowing additions away (signed overflow is undefined in C). A constant side
; has its sign bit flipped instead; a comparison with only one shifted side stays.
; RUN: tc-opt --passes=canonicalize,dce --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @ints(%x: i32, %y: i32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %lt = icmp.ult %x, %y : i1
; CHECK-NEXT:    ret %lt
; CHECK-NEXT:  }
; CHECK-LABEL: device @longs(%x: i64, %y: i64) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %ge = icmp.sge %x, %y : i1
; CHECK-NEXT:    ret %ge
; CHECK-NEXT:  }
; CHECK-LABEL: device @constant(%x: i32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %0 = const -2147483638 : i32
; CHECK-NEXT:    %gt = icmp.ugt %x, %0 : i1
; CHECK-NEXT:    ret %gt
; CHECK-NEXT:  }
; CHECK-LABEL: device @oneSided(%x: i32, %y: i32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %min = const -2147483648 : i32
; CHECK-NEXT:    %a = add %x, %min : i32
; CHECK-NEXT:    %lt = icmp.slt %a, %y : i1
; CHECK-NEXT:    ret %lt
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @ints(%x: i32, %y: i32) -> i1 {
^entry:
  %min = const -2147483648 : i32
  %a = add %x, %min : i32
  %b = add %y, %min : i32
  %lt = icmp.slt %a, %b : i1
  ret %lt
}

device @longs(%x: i64, %y: i64) -> i1 {
^entry:
  %min = const -9223372036854775808 : i64
  %a = sub %x, %min : i64
  %b = add %min, %y : i64
  %ge = icmp.uge %a, %b : i1
  ret %ge
}

device @constant(%x: i32) -> i1 {
^entry:
  %min = const -2147483648 : i32
  %ten = const 10 : i32
  %a = add %x, %min : i32
  %gt = icmp.sgt %a, %ten : i1
  ret %gt
}

device @oneSided(%x: i32, %y: i32) -> i1 {
^entry:
  %min = const -2147483648 : i32
  %a = add %x, %min : i32
  %lt = icmp.slt %a, %y : i1
  ret %lt
}
