; A comparison of a sign-known value (abs, sqrt, x * x, ...) with an operand that is not a constant gets
; a NaN test beside it: ordered a < b becomes (a < b) && ord(a), unordered becomes (a <u b) || uno(a).
; Both are identities. They keep the NaN case out of reach of NVIDIA's compilers, which evaluate an
; operand such as -(float) log(3.4e38) themselves and then fold -88.7 < fabsf(x) to true.
; Comparisons with constants (decided by the canonicalizer), of unknown sign, and equalities stay.
; RUN: tc-opt --passes=nan-guards --no-loc %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device @orderedAgainstExpression(%x: f32, %c: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %s = math.sqrt(%a) : f32
; CHECK-NEXT:    %m = fneg %c : f32
; CHECK-NEXT:    %0 = fcmp.olt %m, %s : i1
; CHECK-NEXT:    %1 = fcmp.ord %m, %s : i1
; CHECK-NEXT:    %2 = and %0, %1 : i1
; CHECK-NEXT:    ret %2
; CHECK-NEXT:  }
; CHECK-LABEL: device @unorderedAgainstExpression(%x: f32, %y: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %xx = fmul %x, %x : f32
; CHECK-NEXT:    %0 = fcmp.ugt %xx, %y : i1
; CHECK-NEXT:    %1 = fcmp.uno %xx, %y : i1
; CHECK-NEXT:    %2 = or %0, %1 : i1
; CHECK-NEXT:    ret %2
; CHECK-NEXT:  }
; CHECK-LABEL: device @unknownSignStays(%x: f32, %y: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %r = fcmp.olt %x, %y : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @equalityStays(%x: f32, %y: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %r = fcmp.oeq %a, %y : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; CHECK-LABEL: device @constantStays(%x: f32) -> i1 {
; CHECK-NEXT:  ^entry:
; CHECK-NEXT:    %one = const 1.0 : f32
; CHECK-NEXT:    %a = math.abs(%x) : f32
; CHECK-NEXT:    %r = fcmp.olt %a, %one : i1
; CHECK-NEXT:    ret %r
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @orderedAgainstExpression(%x: f32, %c: f32) -> i1 {
^entry:
  %a = math.abs(%x) : f32
  %s = math.sqrt(%a) : f32
  %m = fneg %c : f32
  %r = fcmp.olt %m, %s : i1
  ret %r
}

device @unorderedAgainstExpression(%x: f32, %y: f32) -> i1 {
^entry:
  %xx = fmul %x, %x : f32
  %r = fcmp.ugt %xx, %y : i1
  ret %r
}

device @unknownSignStays(%x: f32, %y: f32) -> i1 {
^entry:
  %r = fcmp.olt %x, %y : i1
  ret %r
}

device @equalityStays(%x: f32, %y: f32) -> i1 {
^entry:
  %a = math.abs(%x) : f32
  %r = fcmp.oeq %a, %y : i1
  ret %r
}

device @constantStays(%x: f32) -> i1 {
^entry:
  %one = const 1.0 : f32
  %a = math.abs(%x) : f32
  %r = fcmp.olt %a, %one : i1
  ret %r
}
