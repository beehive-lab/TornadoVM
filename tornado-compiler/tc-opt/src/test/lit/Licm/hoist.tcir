; Loop-invariant pure values (the grid size, a product of invariants) move to the loop entry;
; loads and values that depend on the loop variable stay.
; RUN: tc-opt --passes=licm --no-loc %s | FileCheck %s

; CHECK-LABEL: kernel @k(
; CHECK:       ^entry:
; CHECK:         %n2 = mul %n, %n : i32
; CHECK-NEXT:    %gs = tornado.global_size.x() : i32
; CHECK-NEXT:    br ^head
; CHECK:       ^body:
; CHECK-NEXT:    %v = array.load %a[%i] : f32
; CHECK-NEXT:    %ii = add %i, %gs : i32
kernel @k(%a: array<f32>, %n: i32) -> void {
^entry:
  %i0 = tornado.thread_id.global.x() : i32
  br ^head(%i0)
^head(%i: i32):
  %n2 = mul %n, %n : i32
  %more = icmp.slt %i, %n2 : i1
  cond_br %more, ^body, ^exit
^body:
  %v = array.load %a[%i] : f32
  %gs = tornado.global_size.x() : i32
  %ii = add %i, %gs : i32
  array.store %a[%i], %v
  br ^head(%ii)
^exit:
  ret
}
