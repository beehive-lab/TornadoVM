; CHECK-NEXT:    for (;;) {
; CHECK-NEXT:      if (i >= n) {
; CHECK-NEXT:        r = -1;
; CHECK-NEXT:        break;
; CHECK-NEXT:      }
; CHECK-NEXT:      j = 0;
; CHECK-NEXT:      while (j < n) {
; CHECK-NEXT:        ij = (int) ((uint) i * (uint) n);
; CHECK-NEXT:        idx = (int) ((uint) ij + (uint) j);
; CHECK-NEXT:        v = *((device int *) (grid + (long) ((ulong) (long) idx * (ulong) 4L)));
; CHECK-NEXT:        j1 = (int) ((uint) j + (uint) 1);
