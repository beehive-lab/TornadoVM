; CHECK-LABEL: static inline int early(int a, int b)
; CHECK-NEXT:  {
; CHECK-NEXT:    int k, acc, r, r2;
; CHECK-NEXT:    do {
; CHECK-NEXT:      if (a > 32) {
; CHECK-NEXT:        if (b < 16) {
; CHECK-NEXT:          r = -1000;
; CHECK-NEXT:          break;
; CHECK-NEXT:        }
; CHECK-NEXT:        k = 0;
; CHECK-NEXT:        acc = 0;
; CHECK-NEXT:      } else {
; CHECK-NEXT:        k = 0;
; CHECK-NEXT:        acc = 0;
; CHECK-NEXT:      }
; CHECK-NEXT:      for (;;) {
; CHECK-NEXT:        if (k >= a) {
; CHECK-NEXT:          r = acc;
; CHECK-NEXT:          break;
; CHECK-NEXT:        }
; CHECK-NEXT:        acc = (int) ((uint) acc + (uint) k);
; CHECK-NEXT:        k = (int) ((uint) k + (uint) 1);
; CHECK-NEXT:      }
; CHECK-NEXT:    } while (false);
; CHECK-NEXT:    r2 = (int) ((uint) r * (uint) 2);
; CHECK-NEXT:    return r2;
; CHECK-NEXT:  }
