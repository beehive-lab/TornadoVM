; CHECK-NEXT:      }
; CHECK-NEXT:      if (tc_jump_ == 1) {
; CHECK-NEXT:        tc_jump_ = 0;
; CHECK-NEXT:        break;
; CHECK-NEXT:      }
; CHECK-NEXT:      i = (int) ((uint) i + (uint) 1);
