device @search(%n: i32, %key: i32, %grid: ptr<global>) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  %none = const -1 : i32
  br ^outer(%zero)
^outer(%i: i32):
  %oc = icmp.slt %i, %n : i1
  cond_br %oc, ^inner_pre, ^done(%none)
^inner_pre:
  br ^inner(%zero)
^inner(%j: i32):
  %ic = icmp.slt %j, %n : i1
  cond_br %ic, ^probe, ^next_row
^probe:
  %ij = mul %i, %n : i32
  %idx = add %ij, %j : i32
  %wide = sext %idx : i64
  %four = const 4 : i64
  %off = mul %wide, %four : i64
  %p = ptr.offset %grid, %off : ptr<global>
  %v = load %p : i32
  %hit = icmp.eq %v, %key : i1
  %j1 = add %j, %one : i32
  cond_br %hit, ^done(%idx), ^inner(%j1)
^next_row:
  %i1 = add %i, %one : i32
  br ^outer(%i1)
^done(%r: i32):
  ret %r
}

device @pick(%x: i32) -> i32 {
^entry:
  switch %x [0: ^a, 1: ^b] default ^c
^a:
  %ra = const 10 : i32
  br ^join(%ra)
^b:
  %rb = const 20 : i32
  br ^join(%rb)
^c:
  %rc = const 30 : i32
  br ^join(%rc)
^join(%r: i32):
  ret %r
}

; Restarting the outer loop from the inner one: a goto to the outer loop's label.
device @restart(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  br ^outer(%zero, %zero)
^outer(%i: i32, %acc: i32):
  %done = icmp.sge %i, %n : i1
  cond_br %done, ^exit, ^inner_init
^inner_init:
  %z = const 0 : i32
  br ^inner(%z)
^inner(%j: i32):
  %jd = icmp.sge %j, %n : i1
  cond_br %jd, ^after, ^body
^body:
  %eq = icmp.eq %j, %i : i1
  %one = const 1 : i32
  %i1 = add %i, %one : i32
  %acc1 = add %acc, %j : i32
  cond_br %eq, ^outer(%i1, %acc1), ^next
^next:
  %one2 = const 1 : i32
  %j1 = add %j, %one2 : i32
  br ^inner(%j1)
^after:
  %one3 = const 1 : i32
  %i2 = add %i, %one3 : i32
  br ^outer(%i2, %acc)
^exit:
  ret %acc
}

; Leaving a block from inside nested ifs, before a loop: the block becomes do { ... } while (false).
device @early(%a: i32, %b: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  %c32 = const 32 : i32
  %big = icmp.sgt %a, %c32 : i1
  cond_br %big, ^check, ^loop(%zero, %zero)
^check:
  %c16 = const 16 : i32
  %small = icmp.slt %b, %c16 : i1
  %bad = const -1000 : i32
  cond_br %small, ^done(%bad), ^loop(%zero, %zero)
^loop(%k: i32, %acc: i32):
  %more = icmp.slt %k, %a : i1
  cond_br %more, ^body, ^done(%acc)
^body:
  %acc1 = add %acc, %k : i32
  %one = const 1 : i32
  %k1 = add %k, %one : i32
  br ^loop(%k1, %acc1)
^done(%r: i32):
  %two = const 2 : i32
  %r2 = mul %r, %two : i32
  ret %r2
}
