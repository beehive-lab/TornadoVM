; Java semantics in emitted MSL: masked shift counts, logical >>> through an unsigned type, saturating
; float-to-int, NaN-propagating Math.min/max via preamble helpers, special constants, NaN-aware
; comparisons and unsigned integer comparison. Metal compiles with fast math, which assumes no NaN:
; NaN tests (x != x, unordered predicates) are spelled with isnan.
; RUN: tc-emit --target=metal --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=metal %s | mslcheck
; RUN: tc-emit --target=metal %s | metalc
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #include <metal_stdlib>
; CHECK-NEXT:  using namespace metal;
; CHECK-NEXT:  #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static inline int tc_f2i(float x) { return isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static inline int tc_f2i(half x) { return tc_f2i((float) x); }
; CHECK-NEXT:  static inline long tc_f2l(float x) { return isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807L : x <= -9223372036854775808.0f ? (-9223372036854775807L - 1) : (long) x; }
; CHECK-NEXT:  static inline long tc_f2l(half x) { return tc_f2l((float) x); }
; CHECK-NEXT:  #endif
; CHECK-LABEL: static inline float java_fminf(float a, float b) {
; CHECK-NEXT:    if (isnan(a) || isnan(b)) return as_type<float>(0x7fc00000);
; CHECK-NEXT:    if (a == 0.0f && b == 0.0f) return as_type<float>(as_type<int>(a) | as_type<int>(b));
; CHECK-NEXT:    return a < b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline float java_fmaxf(float a, float b) {
; CHECK-NEXT:    if (isnan(a) || isnan(b)) return as_type<float>(0x7fc00000);
; CHECK-NEXT:    if (a == 0.0f && b == 0.0f) return as_type<float>(as_type<int>(a) & as_type<int>(b));
; CHECK-NEXT:    return a > b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int semantics(int x, int k, long l, float f, float d)
; CHECK-NEXT:  {
; CHECK-NEXT:    int s1, s2, u, fi, bits;
; CHECK-NEXT:    long ul, dl;
; CHECK-NEXT:    float mn, mx;
; CHECK-NEXT:    bool lt, ne, isnum, isnan_, uno, uge, ucmp;
; CHECK-NEXT:    s1 = (int) ((uint) x << (k & 31));
; CHECK-NEXT:    s2 = x >> 3;
; CHECK-NEXT:    u = (int) ((uint) x >> (k & 31));
; CHECK-NEXT:    ul = (long) ((ulong) l >> (l & 63));
; CHECK-NEXT:    fi = tc_f2i(f);
; CHECK-NEXT:    dl = tc_f2l(d);
; CHECK-NEXT:    mn = java_fminf(f, f);
; CHECK-NEXT:    mx = java_fmaxf(d, d);
; CHECK-NEXT:    lt = isnan(f) || isnan(as_type<float>(0x7fc00000)) || f < as_type<float>(0x7fc00000);
; CHECK-NEXT:    ne = f < mn || f > mn;
; CHECK-NEXT:    isnum = !isnan(f);
; CHECK-NEXT:    isnan_ = isnan(d);
; CHECK-NEXT:    uno = isnan(f) || isnan(d);
; CHECK-NEXT:    uge = isnan(f) || isnan(d) || f >= d;
; CHECK-NEXT:    ucmp = (uint) x < (uint) k;
; CHECK-NEXT:    bits = as_type<int>(f);
; CHECK-NEXT:    return s1;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @semantics(%x: i32, %k: i32, %l: i64, %f: f32, %d: f32) -> i32 {
^entry:
  %s1 = shl %x, %k : i32
  %c35 = const 35 : i32
  %s2 = shr %x, %c35 : i32
  %u = ushr %x, %k : i32
  %ul = ushr %l, %l : i64
  %fi = f2i.sat %f : i32
  %dl = f2i.sat %d : i64
  %mn = math.min(%f, %f) : f32
  %mx = math.max(%d, %d) : f32
  %nan = const nan : f32
  %inf = const -inf : f32
  %min = const -2147483648 : i32
  %lt = fcmp.ult %f, %nan : i1
  %ne = fcmp.one %f, %mn : i1
  %isnum = fcmp.oeq %f, %f : i1
  %isnan = fcmp.une %d, %d : i1
  %uno = fcmp.uno %f, %d : i1
  %uge = fcmp.uge %f, %d : i1
  %ucmp = icmp.ult %x, %k : i1
  %bits = bitcast %f : i32
  ret %s1
}
