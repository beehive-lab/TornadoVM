; Atomics on array elements in Metal: overloaded helpers take the element's address in its address
; space (MSL atomics need atomic_* objects); float add is a compare-and-swap loop. MSL has no
; 64-bit add: the low words are added, then the high word with the carry.
; RUN: tc-emit --target=metal --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=metal %s | mslcheck
; RUN: tc-emit --target=metal %s | metalc
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #include <metal_stdlib>
; CHECK-NEXT:  using namespace metal;
; CHECK-NEXT:  #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static inline int tc_f2i(float x) { return isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static inline int tc_f2i(half x) { return tc_f2i((float) x); }
; CHECK-NEXT:  static inline long tc_f2l(float x) { return isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807L : x <= -9223372036854775808.0f ? (-9223372036854775807L - 1) : (long) x; }
; CHECK-NEXT:  static inline long tc_f2l(half x) { return tc_f2l((float) x); }
; CHECK-NEXT:  #endif
; CHECK-LABEL: static inline int tc_atomic_add(device int *p, int v) {
; CHECK-NEXT:    device atomic_int *a = (device atomic_int *) p;
; CHECK-NEXT:    return atomic_fetch_add_explicit(a, v, memory_order_relaxed);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline int tc_atomic_add(threadgroup int *p, int v) {
; CHECK-NEXT:    threadgroup atomic_int *a = (threadgroup atomic_int *) p;
; CHECK-NEXT:    return atomic_fetch_add_explicit(a, v, memory_order_relaxed);
; CHECK-NEXT:  }
; CHECK-LABEL: static inline long tc_atomic_add(device long *p, long v) {
; CHECK-NEXT:    device atomic_uint *w = (device atomic_uint *) p;
; CHECK-NEXT:    uint lo = (uint) v;
; CHECK-NEXT:    uint oldLo = atomic_fetch_add_explicit(&w[0], lo, memory_order_relaxed);
; CHECK-NEXT:    uint hi = (uint) (v >> 32) + (oldLo + lo < oldLo ? 1u : 0u);
; CHECK-NEXT:    uint oldHi = hi != 0u ? atomic_fetch_add_explicit(&w[1], hi, memory_order_relaxed) : atomic_load_explicit(&w[1], memory_order_relaxed);
; CHECK-NEXT:    return (long) (((ulong) oldHi << 32) | oldLo);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline long tc_atomic_add(threadgroup long *p, long v) {
; CHECK-NEXT:    threadgroup atomic_uint *w = (threadgroup atomic_uint *) p;
; CHECK-NEXT:    uint lo = (uint) v;
; CHECK-NEXT:    uint oldLo = atomic_fetch_add_explicit(&w[0], lo, memory_order_relaxed);
; CHECK-NEXT:    uint hi = (uint) (v >> 32) + (oldLo + lo < oldLo ? 1u : 0u);
; CHECK-NEXT:    uint oldHi = hi != 0u ? atomic_fetch_add_explicit(&w[1], hi, memory_order_relaxed) : atomic_load_explicit(&w[1], memory_order_relaxed);
; CHECK-NEXT:    return (long) (((ulong) oldHi << 32) | oldLo);
; CHECK-NEXT:  }
; CHECK-LABEL: static inline float tc_atomic_add(device float *p, float v) {
; CHECK-NEXT:    device atomic_uint *a = (device atomic_uint *) p;
; CHECK-NEXT:    uint old = atomic_load_explicit(a, memory_order_relaxed);
; CHECK-NEXT:    while (!atomic_compare_exchange_weak_explicit(a, &old, as_type<uint>(as_type<float>(old) + v), memory_order_relaxed, memory_order_relaxed)) {
; CHECK-NEXT:    }
; CHECK-NEXT:    return as_type<float>(old);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline float tc_atomic_add(threadgroup float *p, float v) {
; CHECK-NEXT:    threadgroup atomic_uint *a = (threadgroup atomic_uint *) p;
; CHECK-NEXT:    uint old = atomic_load_explicit(a, memory_order_relaxed);
; CHECK-NEXT:    while (!atomic_compare_exchange_weak_explicit(a, &old, as_type<uint>(as_type<float>(old) + v), memory_order_relaxed, memory_order_relaxed)) {
; CHECK-NEXT:    }
; CHECK-NEXT:    return as_type<float>(old);
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int tc_atomic_max(device int *p, int v) {
; CHECK-NEXT:    device atomic_int *a = (device atomic_int *) p;
; CHECK-NEXT:    return atomic_fetch_max_explicit(a, v, memory_order_relaxed);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline int tc_atomic_max(threadgroup int *p, int v) {
; CHECK-NEXT:    threadgroup atomic_int *a = (threadgroup atomic_int *) p;
; CHECK-NEXT:    return atomic_fetch_max_explicit(a, v, memory_order_relaxed);
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int atomics(device unsigned char *p, int i, long n)
; CHECK-NEXT:  {
; CHECK-NEXT:    long lprev;
; CHECK-NEXT:    float prev;
; CHECK-NEXT:    int old;
; CHECK-NEXT:    tc_atomic_add(((device int *) (p + (long) ((ulong) (long) i * (ulong) 4L))), i);
; CHECK-NEXT:    lprev = tc_atomic_add(((device long *) (p + (long) ((ulong) (long) i * (ulong) 8L))), n);
; CHECK-NEXT:    prev = tc_atomic_add(((device float *) (p + (long) ((ulong) (long) i * (ulong) 4L))), 1.0f);
; CHECK-NEXT:    old = tc_atomic_max(((device int *) (p + (long) ((ulong) (long) i * (ulong) 4L))), i);
; CHECK-NEXT:    return old;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @atomics(%p: ptr<global>, %i: i32, %n: i64) -> i32 {
^entry:
  %four = const 4 : i64
  %wide = sext %i : i64
  %off = mul %wide, %four : i64
  %slot = ptr.offset %p, %off : ptr<global>
  tornado.atomic.add(%slot, %i)
  %eight = const 8 : i64
  %loff = mul %wide, %eight : i64
  %lslot = ptr.offset %p, %loff : ptr<global>
  %lprev = tornado.atomic.add(%lslot, %n) : i64
  %fp = ptr.offset %p, %off : ptr<global>
  %one = const 1.0 : f32
  %prev = tornado.atomic.add(%fp, %one) : f32
  %old = tornado.atomic.max(%slot, %i) : i32
  ret %old
}
