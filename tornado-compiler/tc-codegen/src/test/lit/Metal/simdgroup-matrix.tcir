; CHECK-LABEL: static inline void tile(device unsigned char *a, threadgroup unsigned char *s, device unsigned char *c, int base, int ld)
; CHECK-NEXT:  {
; CHECK-NEXT:    simdgroup_float8x8 acc, fa, fb, d;
; CHECK-NEXT:    acc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
; CHECK-NEXT:    fa = tc_simdgroup_load((device const float *) (a), base, ld, false);
; CHECK-NEXT:    fb = tc_simdgroup_load(s, base, ld, false);
; CHECK-NEXT:    d = tc_simdgroup_mma(fa, fb, acc);
; CHECK-NEXT:    tc_simdgroup_store(d, (device float *) (c), base, ld);
; CHECK-NEXT:  }
