device @tile(%a: ptr<global>, %s: ptr<shared>, %c: ptr<global>, %base: i32, %ld: i32) -> void {
^entry:
  %acc = tornado.simdgroup_matrix.zero() : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %fa = tornado.simdgroup_matrix.load(%a, %base, %ld) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %fb = tornado.simdgroup_matrix.load_local(%s, %base, %ld) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %d = tornado.simdgroup_matrix.mma(%fa, %fb, %acc) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  tornado.simdgroup_matrix.store(%d, %c, %base, %ld)
  ret
}

