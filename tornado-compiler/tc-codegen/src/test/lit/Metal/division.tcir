; Java division (JLS 15.17.2): MIN_VALUE / -1 is MIN_VALUE and MIN_VALUE % -1 is 0, which C leaves
; undefined. int and long division by a value that may be -1 goes through java_idiv/java_irem/
; java_ldiv/java_lrem; division by another constant, and narrower types (promoted to int in C),
; stay plain.
; RUN: tc-emit --target=metal --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=metal %s | mslcheck
; RUN: tc-emit --target=metal %s | metalc
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #include <metal_stdlib>
; CHECK-NEXT:  using namespace metal;
; CHECK-NEXT:  #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static inline int tc_f2i(float x) { return isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static inline int tc_f2i(half x) { return tc_f2i((float) x); }
; CHECK-NEXT:  static inline long tc_f2l(float x) { return isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807L : x <= -9223372036854775808.0f ? (-9223372036854775807L - 1) : (long) x; }
; CHECK-NEXT:  static inline long tc_f2l(half x) { return tc_f2l((float) x); }
; CHECK-NEXT:  #endif
; CHECK-LABEL: static inline int java_idiv(int a, int b) {
; CHECK-NEXT:    return b == -1 ? (int) ((uint) 0 - (uint) a) : a / b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int java_irem(int a, int b) {
; CHECK-NEXT:    return b == -1 ? 0 : a % b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline long java_ldiv(long a, long b) {
; CHECK-NEXT:    return b == -1 ? (long) ((ulong) 0 - (ulong) a) : a / b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline long java_lrem(long a, long b) {
; CHECK-NEXT:    return b == -1 ? 0 : a % b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline long divide(int a, int b, long x, long y, short s, short t)
; CHECK-NEXT:  {
; CHECK-NEXT:    int q, r, k, sum, sum2;
; CHECK-NEXT:    long lq, lr, wide, narrow, w, w2, w3;
; CHECK-NEXT:    short sq;
; CHECK-NEXT:    q = java_idiv(a, b);
; CHECK-NEXT:    r = java_irem(a, b);
; CHECK-NEXT:    k = a / 7;
; CHECK-NEXT:    lq = java_ldiv(x, y);
; CHECK-NEXT:    lr = java_lrem(x, y);
; CHECK-NEXT:    sq = s / t;
; CHECK-NEXT:    sum = q + r;
; CHECK-NEXT:    sum2 = sum + k;
; CHECK-NEXT:    wide = (long) sum2;
; CHECK-NEXT:    narrow = (long) sq;
; CHECK-NEXT:    w = wide + lq;
; CHECK-NEXT:    w2 = w + lr;
; CHECK-NEXT:    w3 = w2 + narrow;
; CHECK-NEXT:    return w3;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @divide(%a: i32, %b: i32, %x: i64, %y: i64, %s: i16, %t: i16) -> i64 {
^entry:
  %seven = const 7 : i32
  %q = div %a, %b : i32
  %r = rem %a, %b : i32
  %k = div %a, %seven : i32
  %lq = div %x, %y : i64
  %lr = rem %x, %y : i64
  %sq = div %s, %t : i16
  %sum = add %q, %r : i32
  %sum2 = add %sum, %k : i32
  %wide = sext %sum2 : i64
  %narrow = sext %sq : i64
  %w = add %wide, %lq : i64
  %w2 = add %w, %lr : i64
  %w3 = add %w2, %narrow : i64
  ret %w3
}
