device @negneg(%x: i32, %y: f32) -> f32 {
^entry:
  %0 = neg %x : i32
  %1 = neg %0 : i32
  %2 = i2f %1 : f32
  %3 = fneg %y : f32
  %4 = fneg %3 : f32
  %5 = fadd %2, %4 : f32
  ret %5
}

device @bytes(%p: ptr<global>) -> i32 {
^entry:
  %b = load %p : i8
  %w = sext %b : i32
  ret %w
}

; Vector lanes by number, filled from the lane immediate (MSL vectors index with [], at most four lanes).
device @lanes(%v: vec<4 x f32>) -> f32 {
^entry:
  %a = tornado.vector.lane<lane = 3>(%v) : f32
  %b = tornado.vector.lane<lane = 2>(%v) : f32
  %s = fadd %a, %b : f32
  ret %s
}
