; CHECK-LABEL: static inline float lanes(float4 v)
; CHECK-NEXT:  {
; CHECK-NEXT:    float a, b, s;
; CHECK-NEXT:    a = v[3];
; CHECK-NEXT:    b = v[2];
; CHECK-NEXT:    s = a + b;
; CHECK-NEXT:    return s;
; CHECK-NEXT:  }
