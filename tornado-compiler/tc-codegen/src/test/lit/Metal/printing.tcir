; CHECK-NEXT:  {
; CHECK-NEXT:    char b;
; CHECK-NEXT:    int w;
; CHECK-NEXT:    b = *((device char *) p);
; CHECK-NEXT:    w = (int) b;
; CHECK-NEXT:    return w;
; CHECK-NEXT:  }
