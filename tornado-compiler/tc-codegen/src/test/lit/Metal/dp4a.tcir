; QuantizationUtils.dp4a: MSL has no dp4a instruction, so four signed int8 products are summed in a
; helper; the byte operands may live in any address space (here device and threadgroup).
; RUN: tc-emit --target=metal --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=metal %s | mslcheck
; RUN: tc-emit --target=metal %s | metalc
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #include <metal_stdlib>
; CHECK-NEXT:  using namespace metal;
; CHECK-NEXT:  #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static inline int tc_f2i(float x) { return isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static inline int tc_f2i(half x) { return tc_f2i((float) x); }
; CHECK-NEXT:  static inline long tc_f2l(float x) { return isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807L : x <= -9223372036854775808.0f ? (-9223372036854775807L - 1) : (long) x; }
; CHECK-NEXT:  static inline long tc_f2l(half x) { return tc_f2l((float) x); }
; CHECK-NEXT:  #endif
; CHECK-LABEL: template <typename P, typename Q>
; CHECK-NEXT:  static inline int tc_dp4a(P a, long ao, Q b, long bo, int c) {
; CHECK-NEXT:    return c + (int) (char) a[ao] * (int) (char) b[bo] + (int) (char) a[ao + 1] * (int) (char) b[bo + 1]
; CHECK-NEXT:        + (int) (char) a[ao + 2] * (int) (char) b[bo + 2] + (int) (char) a[ao + 3] * (int) (char) b[bo + 3];
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int tc_dp4a_packed(int a, int b, int c) {
; CHECK-NEXT:    char4 x = as_type<char4>(a), y = as_type<char4>(b);
; CHECK-NEXT:    return c + (int) x.x * (int) y.x + (int) x.y * (int) y.y + (int) x.z * (int) y.z + (int) x.w * (int) y.w;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline int dot(device unsigned char *a, long oa, threadgroup unsigned char *b, long ob, int c, int x, int y)
; CHECK-NEXT:  {
; CHECK-NEXT:    int d, p;
; CHECK-NEXT:    d = tc_dp4a(a, oa, b, ob, c);
; CHECK-NEXT:    p = tc_dp4a_packed(x, y, d);
; CHECK-NEXT:    return p;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @dot(%a: ptr<global>, %oa: i64, %b: ptr<shared>, %ob: i64, %c: i32, %x: i32, %y: i32) -> i32 {
^entry:
  %d = tornado.dp4a(%a, %oa, %b, %ob, %c) : i32
  %p = tornado.dp4a.packed(%x, %y, %d) : i32
  ret %p
}
