; Half-precision and transposed simdgroup matrices: a Matrix8x8Half value is an MSL simdgroup_half8x8;
; loads read device or threadgroup memory, plain or transposed (simdgroup_load's transpose flag); half
; and mixed half/float inputs accumulate into a float fragment; a store may write threadgroup memory.
; RUN: tc-emit --target=metal --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=metal %s | mslcheck
; RUN: tc-emit --target=metal %s | metalc
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #include <metal_stdlib>
; CHECK-NEXT:  using namespace metal;
; CHECK-NEXT:  #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static inline int tc_f2i(float x) { return isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static inline int tc_f2i(half x) { return tc_f2i((float) x); }
; CHECK-NEXT:  static inline long tc_f2l(float x) { return isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807L : x <= -9223372036854775808.0f ? (-9223372036854775807L - 1) : (long) x; }
; CHECK-NEXT:  static inline long tc_f2l(half x) { return tc_f2l((float) x); }
; CHECK-NEXT:  #endif
; CHECK-LABEL: static inline simdgroup_float8x8 tc_simdgroup_load(device const float *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    simdgroup_float8x8 m;
; CHECK-NEXT:    simdgroup_load(m, p + base, (ulong) stride, ulong2(0, 0), transpose);
; CHECK-NEXT:    return m;
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_float8x8 tc_simdgroup_load(threadgroup const float *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    simdgroup_float8x8 m;
; CHECK-NEXT:    simdgroup_load(m, p + base, (ulong) stride, ulong2(0, 0), transpose);
; CHECK-NEXT:    return m;
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_float8x8 tc_simdgroup_load(device const unsigned char *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    return tc_simdgroup_load((device const float *) p, base, stride, transpose);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_float8x8 tc_simdgroup_load(threadgroup const unsigned char *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    return tc_simdgroup_load((threadgroup const float *) p, base, stride, transpose);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_half8x8 tc_simdgroup_load_half(device const half *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    simdgroup_half8x8 m;
; CHECK-NEXT:    simdgroup_load(m, p + base, (ulong) stride, ulong2(0, 0), transpose);
; CHECK-NEXT:    return m;
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_half8x8 tc_simdgroup_load_half(threadgroup const half *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    simdgroup_half8x8 m;
; CHECK-NEXT:    simdgroup_load(m, p + base, (ulong) stride, ulong2(0, 0), transpose);
; CHECK-NEXT:    return m;
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_half8x8 tc_simdgroup_load_half(device const unsigned char *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    return tc_simdgroup_load_half((device const half *) p, base, stride, transpose);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline simdgroup_half8x8 tc_simdgroup_load_half(threadgroup const unsigned char *p, int base, int stride, bool transpose) {
; CHECK-NEXT:    return tc_simdgroup_load_half((threadgroup const half *) p, base, stride, transpose);
; CHECK-NEXT:  }
; CHECK-NEXT:  template <typename A, typename B>
; CHECK-NEXT:  static inline simdgroup_float8x8 tc_simdgroup_mma(A a, B b, simdgroup_float8x8 c) {
; CHECK-NEXT:    simdgroup_float8x8 d;
; CHECK-NEXT:    simdgroup_multiply_accumulate(d, a, b, c);
; CHECK-NEXT:    return d;
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline void tc_simdgroup_store(simdgroup_float8x8 m, device float *p, int base, int stride) {
; CHECK-NEXT:    simdgroup_store(m, p + base, (ulong) stride);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline void tc_simdgroup_store(simdgroup_float8x8 m, threadgroup float *p, int base, int stride) {
; CHECK-NEXT:    simdgroup_store(m, p + base, (ulong) stride);
; CHECK-NEXT:  }
; CHECK-NEXT:  static inline void tc_simdgroup_store(simdgroup_float8x8 m, device unsigned char *p, int base, int stride) {
