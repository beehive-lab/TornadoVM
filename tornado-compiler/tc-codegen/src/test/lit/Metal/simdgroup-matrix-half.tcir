; CHECK-NEXT:  }
; CHECK-NEXT:  static inline void tc_simdgroup_store(simdgroup_float8x8 m, threadgroup unsigned char *p, int base, int stride) {
; CHECK-NEXT:    tc_simdgroup_store(m, (threadgroup float *) p, base, stride);
; CHECK-NEXT:  }
; CHECK-LABEL: static inline void half_tile(device unsigned char *x, threadgroup unsigned char *w, device unsigned char *f, threadgroup unsigned char *c, int base, int ld)
; CHECK-NEXT:  {
; CHECK-NEXT:    simdgroup_float8x8 acc, g, d1, d2, d3;
; CHECK-NEXT:    simdgroup_half8x8 a, b;
; CHECK-NEXT:    acc = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);
; CHECK-NEXT:    a = tc_simdgroup_load_half((device const half *) (x), base, ld, false);
; CHECK-NEXT:    b = tc_simdgroup_load_half(w, base, ld, true);
; CHECK-NEXT:    g = tc_simdgroup_load((device const float *) (f), base, ld, true);
; CHECK-NEXT:    d1 = tc_simdgroup_mma(a, b, acc);
; CHECK-NEXT:    d2 = tc_simdgroup_mma(g, b, d1);
; CHECK-NEXT:    d3 = tc_simdgroup_mma(a, g, d2);
; CHECK-NEXT:    tc_simdgroup_store(d3, c, base, ld);
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @half_tile(%x: ptr<global>, %w: ptr<shared>, %f: ptr<global>, %c: ptr<shared>, %base: i32, %ld: i32) -> void {
^entry:
  %acc = tornado.simdgroup_matrix.zero() : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %a = tornado.simdgroup_matrix.load_half(%x, %base, %ld) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Half>
  %b = tornado.simdgroup_matrix.load_half_local_transposed(%w, %base, %ld) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Half>
  %g = tornado.simdgroup_matrix.load_transposed(%f, %base, %ld) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %d1 = tornado.simdgroup_matrix.mma(%a, %b, %acc) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %d2 = tornado.simdgroup_matrix.mma(%g, %b, %d1) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  %d3 = tornado.simdgroup_matrix.mma(%a, %g, %d2) : obj<uk.ac.manchester.tornado.api.types.matrix.Matrix8x8Float>
  tornado.simdgroup_matrix.store_local(%d3, %c, %base, %ld)
  ret
}
