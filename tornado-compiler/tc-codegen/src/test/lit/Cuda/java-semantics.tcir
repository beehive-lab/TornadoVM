; Java semantics in emitted CUDA: masked shift counts, logical >>> through an unsigned type, saturating
; float-to-int, NaN-propagating Math.min/max via preamble helpers, special constants, NaN-aware
; comparisons and unsigned integer comparison.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static inline float java_fminf(float a, float b) {
; CHECK-NEXT:    if (a != a || b != b) return __int_as_float(0x7fc00000);
; CHECK-NEXT:    if (a == 0.0f && b == 0.0f) return __int_as_float(__float_as_int(a) | __float_as_int(b));
; CHECK-NEXT:    return a < b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline double java_fmax(double a, double b) {
; CHECK-NEXT:    if (a != a || b != b) return __longlong_as_double(0x7ff8000000000000LL);
; CHECK-NEXT:    if (a == 0.0 && b == 0.0) return __longlong_as_double(__double_as_longlong(a) & __double_as_longlong(b));
; CHECK-NEXT:    return a > b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int semantics(int x, int k, long long l, float f, double d)
; CHECK-NEXT:  {
; CHECK-NEXT:    int s1;
; CHECK-NEXT:    int s2;
; CHECK-NEXT:    int u;
; CHECK-NEXT:    long long ul;
; CHECK-NEXT:    int fi;
; CHECK-NEXT:    long long dl;
; CHECK-NEXT:    float mn;
; CHECK-NEXT:    double mx;
; CHECK-NEXT:    bool lt;
; CHECK-NEXT:    bool ne;
; CHECK-NEXT:    bool ucmp;
; CHECK-NEXT:    int bits;
; CHECK-NEXT:    s1 = x << (k & 31);
; CHECK-NEXT:    s2 = x >> 3;
; CHECK-NEXT:    u = (int) ((unsigned int) x >> (k & 31));
; CHECK-NEXT:    ul = (long long) ((unsigned long long) l >> (l & 63));
; CHECK-NEXT:    fi = __float2int_rz(f);
; CHECK-NEXT:    dl = __double2ll_rz(d);
; CHECK-NEXT:    mn = java_fminf(f, f);
; CHECK-NEXT:    mx = java_fmax(d, d);
; CHECK-NEXT:    lt = !(f >= __int_as_float(0x7fc00000));
; CHECK-NEXT:    ne = f < mn || f > mn;
; CHECK-NEXT:    ucmp = (unsigned int) x < (unsigned int) k;
; CHECK-NEXT:    bits = __float_as_int(f);
; CHECK-NEXT:    return s1;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: nvcc
device @semantics(%x: i32, %k: i32, %l: i64, %f: f32, %d: f64) -> i32 {
^entry:
  %s1 = shl %x, %k : i32
  %c35 = const 35 : i32
  %s2 = shr %x, %c35 : i32
  %u = ushr %x, %k : i32
  %ul = ushr %l, %l : i64
  %fi = f2i.sat %f : i32
  %dl = f2i.sat %d : i64
  %mn = math.min(%f, %f) : f32
  %mx = math.max(%d, %d) : f64
  %nan = const nan : f32
  %inf = const -inf : f64
  %min = const -2147483648 : i32
  %lt = fcmp.ult %f, %nan : i1
  %ne = fcmp.one %f, %mn : i1
  %ucmp = icmp.ult %x, %k : i1
  %bits = bitcast %f : i32
  ret %s1
}
