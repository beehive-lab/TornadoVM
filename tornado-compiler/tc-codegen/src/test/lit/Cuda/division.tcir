; Java division (JLS 15.17.2): MIN_VALUE / -1 is MIN_VALUE and MIN_VALUE % -1 is 0, which C leaves
; undefined. int and long division by a value that may be -1 goes through java_idiv/java_irem/
; java_ldiv/java_lrem; division by another constant, and narrower types (promoted to int in C),
; stay plain.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static inline int java_idiv(int a, int b) {
; CHECK-NEXT:    return b == -1 ? (int) ((unsigned int) 0 - (unsigned int) a) : a / b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline int java_irem(int a, int b) {
; CHECK-NEXT:    return b == -1 ? 0 : a % b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline long long java_ldiv(long long a, long long b) {
; CHECK-NEXT:    return b == -1 ? (long long) ((unsigned long long) 0 - (unsigned long long) a) : a / b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline long long java_lrem(long long a, long long b) {
; CHECK-NEXT:    return b == -1 ? 0 : a % b;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static long long divide(int a, int b, long long x, long long y, short s, short t)
; CHECK-NEXT:  {
; CHECK-NEXT:    int q, r, k, sum, sum2;
; CHECK-NEXT:    long long lq, lr, wide, narrow, w, w2, w3;
; CHECK-NEXT:    short sq;
; CHECK-NEXT:    q = java_idiv(a, b);
; CHECK-NEXT:    r = java_irem(a, b);
; CHECK-NEXT:    k = a / 7;
; CHECK-NEXT:    lq = java_ldiv(x, y);
; CHECK-NEXT:    lr = java_lrem(x, y);
; CHECK-NEXT:    sq = s / t;
; CHECK-NEXT:    sum = (int) ((unsigned int) q + (unsigned int) r);
; CHECK-NEXT:    sum2 = (int) ((unsigned int) sum + (unsigned int) k);
; CHECK-NEXT:    wide = (long long) sum2;
; CHECK-NEXT:    narrow = (long long) sq;
; CHECK-NEXT:    w = (long long) ((unsigned long long) wide + (unsigned long long) lq);
; CHECK-NEXT:    w2 = (long long) ((unsigned long long) w + (unsigned long long) lr);
; CHECK-NEXT:    w3 = (long long) ((unsigned long long) w2 + (unsigned long long) narrow);
; CHECK-NEXT:    return w3;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @divide(%a: i32, %b: i32, %x: i64, %y: i64, %s: i16, %t: i16) -> i64 {
^entry:
  %seven = const 7 : i32
  %q = div %a, %b : i32
  %r = rem %a, %b : i32
  %k = div %a, %seven : i32
  %lq = div %x, %y : i64
  %lr = rem %x, %y : i64
  %sq = div %s, %t : i16
  %sum = add %q, %r : i32
  %sum2 = add %sum, %k : i32
  %wide = sext %sum2 : i64
  %narrow = sext %sq : i64
  %w = add %wide, %lq : i64
  %w2 = add %w, %lr : i64
  %w3 = add %w2, %narrow : i64
  ret %w3
}
