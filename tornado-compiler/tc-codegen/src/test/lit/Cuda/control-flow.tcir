; Jumps C cannot express structurally become goto: leaving two loops at once, and restarting an outer
; loop from an inner one; a switch keeps plain breaks.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static int search(int n, int key, unsigned char *grid)
; CHECK-NEXT:  {
; CHECK-NEXT:    int i;
; CHECK-NEXT:    int j;
; CHECK-NEXT:    int idx;
; CHECK-NEXT:    int v;
; CHECK-NEXT:    int r;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    for (;;) {
; CHECK-NEXT:      if (i < n) {
; CHECK-NEXT:        j = 0;
; CHECK-NEXT:        while (j < n) {
; CHECK-NEXT:          idx = i * n + j;
; CHECK-NEXT:          v = *((int *) (grid + (long long) idx * 4LL));
; CHECK-NEXT:          if (v == key) {
; CHECK-NEXT:            r = idx;
; CHECK-NEXT:            goto L_done;
; CHECK-NEXT:          } else {
; CHECK-NEXT:            j = j + 1;
; CHECK-NEXT:          }
; CHECK-NEXT:        }
; CHECK-NEXT:        i = i + 1;
; CHECK-NEXT:      } else {
; CHECK-NEXT:        r = -1;
; CHECK-NEXT:        break;
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    L_done: ;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int pick(int x)
; CHECK-NEXT:  {
; CHECK-NEXT:    int r;
; CHECK-NEXT:    switch (x) {
; CHECK-NEXT:    case 0:
; CHECK-NEXT:      r = 10;
; CHECK-NEXT:      break;
; CHECK-NEXT:    case 1:
; CHECK-NEXT:      r = 20;
; CHECK-NEXT:      break;
; CHECK-NEXT:    default:
; CHECK-NEXT:      r = 30;
; CHECK-NEXT:      break;
; CHECK-NEXT:    }
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: nvcc
device @search(%n: i32, %key: i32, %grid: ptr<global>) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  %none = const -1 : i32
  br ^outer(%zero)
^outer(%i: i32):
  %oc = icmp.slt %i, %n : i1
  cond_br %oc, ^inner_pre, ^done(%none)
^inner_pre:
  br ^inner(%zero)
^inner(%j: i32):
  %ic = icmp.slt %j, %n : i1
  cond_br %ic, ^probe, ^next_row
^probe:
  %ij = mul %i, %n : i32
  %idx = add %ij, %j : i32
  %wide = sext %idx : i64
  %four = const 4 : i64
  %off = mul %wide, %four : i64
  %p = ptr.offset %grid, %off : ptr<global>
  %v = load %p : i32
  %hit = icmp.eq %v, %key : i1
  %j1 = add %j, %one : i32
  cond_br %hit, ^done(%idx), ^inner(%j1)
^next_row:
  %i1 = add %i, %one : i32
  br ^outer(%i1)
^done(%r: i32):
  ret %r
}

device @pick(%x: i32) -> i32 {
^entry:
  switch %x [0: ^a, 1: ^b] default ^c
^a:
  %ra = const 10 : i32
  br ^join(%ra)
^b:
  %rb = const 20 : i32
  br ^join(%rb)
^c:
  %rc = const 30 : i32
  br ^join(%rc)
^join(%r: i32):
  ret %r
}
