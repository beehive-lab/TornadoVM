; KernelContext.launch: a device-side launch of a kernel compiled into the same module (CUDA dynamic
; parallelism). The grid rounds the global size up to whole blocks; the child gets the parent's four
; ABI regions and the launch arguments (arrays as they are, header included). TAIL and
; FIRE_AND_FORGET launch into the CUDA named streams; every launch is checked for a launch error.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static inline void tc_device_launch_check(const long long *context, const char *child, const char *label, unsigned gx, unsigned gy, unsigned gz, dim3 grid, dim3 block) {
; CHECK-NEXT:    cudaError_t error = cudaGetLastError();
; CHECK-NEXT:    if (error != cudaSuccess) printf("[TornadoVM-CUDA] device launch of %s failed: %s\n", child, cudaGetErrorString(error));
; CHECK-NEXT:    if (context[3]) printf("Task info: %s\n\tLaunched by       : block [%u, %u, %u] thread [%u, %u, %u]\n\tGlobal work size  : [%u, %u, %u]\n"
; CHECK-NEXT:                           "\tLocal  work size  : [%u, %u, %u]\n\tNumber of workgroups  : [%u, %u, %u]\n\n", label,
; CHECK-NEXT:                           blockIdx.x, blockIdx.y, blockIdx.z, threadIdx.x, threadIdx.y, threadIdx.z, gx, gy, gz, block.x, block.y, block.z, grid.x, grid.y, grid.z);
; CHECK-NEXT:  }
; CHECK-LABEL: extern "C" __global__ void Parent_run(long long *_kernel_context, unsigned char *_constant_region, unsigned char *_local_region, int *_atomics, unsigned char *a, int n)
; CHECK-NEXT:  {
; CHECK-NEXT:    {
; CHECK-NEXT:      dim3 _dp_block(128, 1, 1);
; CHECK-NEXT:      dim3 _dp_grid(((unsigned) n + _dp_block.x - 1) / _dp_block.x, 1, 1);
; CHECK-NEXT:      pkg_Kernels_child_dp<<<_dp_grid, _dp_block>>>(_kernel_context, _constant_region, _local_region, _atomics, a, n);
; CHECK-NEXT:      tc_device_launch_check(_kernel_context, "Kernels.child", "? -> Kernels.child (device launch, DEFAULT)", n, 1, 1, _dp_grid, _dp_block);
; CHECK-NEXT:    }
; CHECK-NEXT:    {
; CHECK-NEXT:      dim3 _dp_block(1, 1, 1);
; CHECK-NEXT:      dim3 _dp_grid(1, 1, 1);
; CHECK-NEXT:      pkg_Kernels_Inner_sum_dp<<<_dp_grid, _dp_block, 0, cudaStreamTailLaunch>>>(_kernel_context, _constant_region, _local_region, _atomics, a, 2.5f);
; CHECK-NEXT:      tc_device_launch_check(_kernel_context, "Kernels$Inner.sum", "? -> Kernels$Inner.sum (device launch, TAIL)", 1, 1, 1, _dp_grid, _dp_block);
; CHECK-NEXT:    }
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
kernel @Parent.run(%a: ptr<global>, %n: i32) -> void {
^entry:
  %one = const 1 : i32
  %block = const 128 : i32
  tornado.device_launch<callee = "pkg.Kernels.child", mode = "default">(%n, %one, %one, %block, %one, %one, %a, %n)
  %half = const 2.5 : f32
  tornado.device_launch<callee = "pkg.Kernels$Inner.sum", mode = "tail">(%one, %one, %one, %one, %one, %one, %a, %half)
  ret
}
