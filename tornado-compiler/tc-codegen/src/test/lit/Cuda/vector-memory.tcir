; A vector at consecutive floats of an array at a byte offset (model frontends: HAT's float4View and
; storeFloat4View). CUDA takes one 64/128-bit access when the address is aligned for it and goes lane by
; lane otherwise (Java allows any element index); OpenCL's vloadn/vstoren need only element alignment.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static inline float4 tc_vload_float4(const char *p) {
; CHECK-NEXT:    if ((((unsigned long long) p) & 15ull) == 0ull) return *((const float4 *) p);
; CHECK-NEXT:    const float *f = (const float *) p;
; CHECK-NEXT:    return make_float4(f[0], f[1], f[2], f[3]);
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_vstore_float4(char *p, float4 v) {
; CHECK-NEXT:    if ((((unsigned long long) p) & 15ull) == 0ull) { *((float4 *) p) = v; return; }
; CHECK-NEXT:    float *f = (float *) p;
; CHECK-NEXT:    f[0] = v.x; f[1] = v.y; f[2] = v.z; f[3] = v.w;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline float2 tc_vload_float2(const char *p) {
; CHECK-NEXT:    if ((((unsigned long long) p) & 7ull) == 0ull) return *((const float2 *) p);
; CHECK-NEXT:    const float *f = (const float *) p;
; CHECK-NEXT:    return make_float2(f[0], f[1]);
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_vstore_float2(char *p, float2 v) {
; CHECK-NEXT:    if ((((unsigned long long) p) & 7ull) == 0ull) { *((float2 *) p) = v; return; }
; CHECK-NEXT:    float *f = (float *) p;
; CHECK-NEXT:    f[0] = v.x; f[1] = v.y;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static float copy4(unsigned char *src, unsigned char *dst, long long from, long long to)
; CHECK-NEXT:  {
; CHECK-NEXT:    float4 v;
; CHECK-NEXT:    float2 w;
; CHECK-NEXT:    float first;
; CHECK-NEXT:    v = tc_vload_float4((const char *) (src) + (from));
; CHECK-NEXT:    tc_vstore_float4((char *) (dst) + (to), v);
; CHECK-NEXT:    w = tc_vload_float2((const char *) (src) + (to));
; CHECK-NEXT:    tc_vstore_float2((char *) (dst) + (from), w);
; CHECK-NEXT:    first = v.x;
; CHECK-NEXT:    return first;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; ---- end of autogenerated checks ----

device @copy4(%src: ptr<global>, %dst: ptr<global>, %from: i64, %to: i64) -> f32 {
^entry:
  %v = tornado.vector.load(%src, %from) : vec<4 x f32>
  tornado.vector.store(%dst, %to, %v)
  %w = tornado.vector.load(%src, %to) : vec<2 x f32>
  tornado.vector.store(%dst, %from, %w)
  %first = tornado.vector.lane<lane = 0>(%v) : f32
  ret %first
}
