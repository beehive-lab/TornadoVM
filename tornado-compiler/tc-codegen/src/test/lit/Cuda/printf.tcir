; Debug.printf: every thread prints, prefixed with its global id, as on the Graal path. The format
; travels as an attribute holding a C string body (quotes and control characters as octal escapes,
; never a raw quote); the arguments are the varargs values.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static void show(int i, float x)
; CHECK-NEXT:  {
; CHECK-NEXT:    printf("tornado[%3d,%3d,%3d]> value a[%d] = %f \042q\042\n", (int) (blockIdx.x * blockDim.x + threadIdx.x), (int) (blockIdx.y * blockDim.y + threadIdx.y), (int) (blockIdx.z * blockDim.z + threadIdx.z), i, x);
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @show(%i: i32, %x: f32) -> void {
^entry:
  tornado.printf(%i, %x) [format("value a[%d] = %f \042q\042\n")]
  ret
}
