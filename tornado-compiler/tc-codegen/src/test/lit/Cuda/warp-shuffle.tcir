; KernelContext.simdShuffle: each lane reads the value of any lane of its warp (SIMD group), int or
; float, the full warp taking part.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static float shuffle(int v, float f, int lane)
; CHECK-NEXT:  {
; CHECK-NEXT:    int w;
; CHECK-NEXT:    float g, wf, r;
; CHECK-NEXT:    w = __shfl_sync(0xffffffffu, v, lane);
; CHECK-NEXT:    g = __shfl_sync(0xffffffffu, f, lane);
; CHECK-NEXT:    wf = (float) w;
; CHECK-NEXT:    r = g + wf;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @shuffle(%v: i32, %f: f32, %lane: i32) -> f32 {
^entry:
  %w = tornado.simd.shuffle(%v, %lane) : i32
  %g = tornado.simd.shuffle(%f, %lane) : f32
  %wf = i2f %w : f32
  %r = fadd %g, %wf : f32
  ret %r
}
