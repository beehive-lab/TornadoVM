; KernelContext warp operations and atomics: simdSum is a butterfly reduction helper (every lane
; gets the sum), the others are the CUDA warp intrinsics with a full mask; Java booleans stay 0/1.
; Atomics take the element's address (`&a[i]`, or a typed cast for a raw pointer); long adds go
; through unsigned long long, as CUDA has no signed 64-bit atomicAdd.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static inline float tc_warp_sum(float v) {
; CHECK-NEXT:    for (int lane = 16; lane > 0; lane >>= 1) v += __shfl_xor_sync(0xffffffffu, v, lane);
; CHECK-NEXT:    return v;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static float warp(float v, int p)
; CHECK-NEXT:  {
; CHECK-NEXT:    float s, d, b, f, r;
; CHECK-NEXT:    int any, mask, sum;
; CHECK-NEXT:    s = tc_warp_sum(v);
; CHECK-NEXT:    d = __shfl_down_sync(0xffffffffu, s, 1);
; CHECK-NEXT:    b = __shfl_sync(0xffffffffu, d, 0);
; CHECK-NEXT:    any = (__any_sync(0xffffffffu, p) != 0);
; CHECK-NEXT:    mask = (int) __ballot_sync(0xffffffffu, p);
; CHECK-NEXT:    sum = any + mask;
; CHECK-NEXT:    f = (float) sum;
; CHECK-NEXT:    r = b + f;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int atomics(unsigned char *p, int i, long long n)
; CHECK-NEXT:  {
; CHECK-NEXT:    int old;
; CHECK-NEXT:    atomicAdd(((int *) (p + (long long) i * 4LL)), i);
; CHECK-NEXT:    atomicAdd((unsigned long long *) ((long long *) p), (unsigned long long) n);
; CHECK-NEXT:    old = atomicMax(((int *) (p + (long long) i * 4LL)), i);
; CHECK-NEXT:    return old;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @warp(%v: f32, %p: i32) -> f32 {
^entry:
  %s = tornado.simd.sum(%v) : f32
  %one = const 1 : i32
  %d = tornado.simd.shuffle_down(%s, %one) : f32
  %b = tornado.simd.broadcast_first(%d) : f32
  %any = tornado.simd.any(%p) : i32
  %mask = tornado.simd.ballot(%p) : i32
  %sum = add %any, %mask : i32
  %f = i2f %sum : f32
  %r = fadd %b, %f : f32
  ret %r
}

device @atomics(%p: ptr<global>, %i: i32, %n: i64) -> i32 {
^entry:
  %four = const 4 : i64
  %wide = sext %i : i64
  %off = mul %wide, %four : i64
  %slot = ptr.offset %p, %off : ptr<global>
  tornado.atomic.add(%slot, %i)
  tornado.atomic.add(%p, %n)
  %old = tornado.atomic.max(%slot, %i) : i32
  ret %old
}
