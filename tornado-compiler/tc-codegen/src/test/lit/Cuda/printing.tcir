; Printing never changes meaning (design review CG-1, CG-2, CG-10):
; - a negated negative operand prints -(-x), not the decrement --x;
; - an operand folded into a spelling template is parenthesised unless it fills a whole call
;   argument: (long long) (i + j) * 2, and x - (i * j);
; - Java byte is signed char (plain char's signedness is implementation-defined).
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static float negneg(int x, float y)
; CHECK-NEXT:  {
; CHECK-NEXT:    return (float) -(-x) + -(-y);
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_cp_async_4(int *dst, const char *src) {
; CHECK-NEXT:    unsigned s = (unsigned) __cvta_generic_to_shared(dst);
; CHECK-NEXT:    asm volatile("cp.async.ca.shared.global [%0], [%1], 4;" :: "r"(s), "l"(src) : "memory");
; CHECK-NEXT:  }
; CHECK-LABEL: extern "C" __global__ void cpasync(long long *_kernel_context, unsigned char *_constant_region, unsigned char *_local_region, int *_atomics, unsigned char *tile, int slot, unsigned char *src, int i, int j, unsigned char *out)
; CHECK-NEXT:  {
; CHECK-NEXT:    int v2;
; CHECK-NEXT:    tc_cp_async_4((int *) tile + slot, (const char *) src + (long long) (i + j) * 2);
; CHECK-NEXT:    v2 = atomicSub(&_atomics[3], i * j) - (i * j);
; CHECK-NEXT:    *((int *) out) = v2 * i;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int bytes(unsigned char *p)
; CHECK-NEXT:  {
; CHECK-NEXT:    signed char b;
; CHECK-NEXT:    int w;
; CHECK-NEXT:    b = *((signed char *) p);
; CHECK-NEXT:    w = (int) b;
; CHECK-NEXT:    return w;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @negneg(%x: i32, %y: f32) -> f32 {
^entry:
  %0 = neg %x : i32
  %1 = neg %0 : i32
  %2 = i2f %1 : f32
  %3 = fneg %y : f32
  %4 = fneg %3 : f32
  %5 = fadd %2, %4 : f32
  ret %5
}

kernel @cpasync(%tile: ptr<global>, %slot: i32, %src: ptr<global>, %i: i32, %j: i32, %out: ptr<global>) -> void {
^entry:
  %0 = add %i, %j : i32
  tornado.async_copy.4.e2(%tile, %slot, %src, %0)
  %c = const 3 : i32
  %1 = mul %i, %j : i32
  %2 = tornado.atomic_int.sub_get(%c, %1) : i32
  %3 = mul %2, %i : i32
  store %out, %3
  ret
}

device @bytes(%p: ptr<global>) -> i32 {
^entry:
  %b = load %p : i8
  %w = sext %b : i32
  ret %w
}
