; Java names that mean something in CUDA C++ are renamed by Naming, never rejected: keywords and
; alternative operator tokens (and), functions the emitter calls (max, sqrtf, printf), built-ins
; and types (threadIdx, half, float2), macros (INFINITY), TC's helper namespace (tc_with) and the
; tile alias (ct) get a `_` suffix; names in the underscore namespace (_kernel_context) get a `v`
; prefix; characters C does not allow ($) become `_`; clashes get _1.
; RUN: tc-emit --no-line-comments %s | FileCheck %s
; RUN: tc-emit %s | nvcc-ptx
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: __device__ static int names(int and_, int max_, int sqrtf_, int printf_, int threadIdx_, int half_, int float2_, int INFINITY_, int tc_with_, int ct_, int v_kernel_context, int a_b, int and__1)
; CHECK-NEXT:  {
; CHECK-NEXT:    int s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12;
; CHECK-NEXT:    s1 = (int) ((unsigned int) and_ + (unsigned int) max_);
; CHECK-NEXT:    s2 = (int) ((unsigned int) s1 + (unsigned int) sqrtf_);
; CHECK-NEXT:    s3 = (int) ((unsigned int) s2 + (unsigned int) printf_);
; CHECK-NEXT:    s4 = (int) ((unsigned int) s3 + (unsigned int) threadIdx_);
; CHECK-NEXT:    s5 = (int) ((unsigned int) s4 + (unsigned int) half_);
; CHECK-NEXT:    s6 = (int) ((unsigned int) s5 + (unsigned int) float2_);
; CHECK-NEXT:    s7 = (int) ((unsigned int) s6 + (unsigned int) INFINITY_);
; CHECK-NEXT:    s8 = (int) ((unsigned int) s7 + (unsigned int) tc_with_);
; CHECK-NEXT:    s9 = (int) ((unsigned int) s8 + (unsigned int) ct_);
; CHECK-NEXT:    s10 = (int) ((unsigned int) s9 + (unsigned int) v_kernel_context);
; CHECK-NEXT:    s11 = (int) ((unsigned int) s10 + (unsigned int) a_b);
; CHECK-NEXT:    s12 = (int) ((unsigned int) s11 + (unsigned int) and__1);
; CHECK-NEXT:    return s12;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @names(%and: i32, %max: i32, %sqrtf: i32, %printf: i32, %threadIdx: i32, %half: i32, %float2: i32, %INFINITY: i32, %tc_with: i32, %ct: i32, %_kernel_context: i32, %a$b: i32, %and_: i32) -> i32 {
^entry:
  %s1 = add %and, %max : i32
  %s2 = add %s1, %sqrtf : i32
  %s3 = add %s2, %printf : i32
  %s4 = add %s3, %threadIdx : i32
  %s5 = add %s4, %half : i32
  %s6 = add %s5, %float2 : i32
  %s7 = add %s6, %INFINITY : i32
  %s8 = add %s7, %tc_with : i32
  %s9 = add %s8, %ct : i32
  %s10 = add %s9, %_kernel_context : i32
  %s11 = add %s10, %a$b : i32
  %s12 = add %s11, %and_ : i32
  ret %s12
}
