; Java zero-fills `new int[n]`: a private array is declared with `= {}` (the codegen.TestPrivateArrayZeroInit
; read-before-write cases). Shared arrays (KernelContext.allocate*LocalArray) stay uninitialised, as on Graal.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int sum(int k)
; CHECK-NEXT:  {
; CHECK-NEXT:    int acc[8] = {};
; CHECK-NEXT:    int v;
; CHECK-NEXT:    v = acc[k];
; CHECK-NEXT:    return v;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: opencl
device @sum(%k: i32) -> i32 {
^entry:
  %acc = alloca.private i32[8] : ptr<private>
  %four = const 4 : i64
  %wide = sext %k : i64
  %off = mul %wide, %four : i64
  %slot = ptr.offset %acc, %off : ptr<private>
  %v = load %slot : i32
  ret %v
}
