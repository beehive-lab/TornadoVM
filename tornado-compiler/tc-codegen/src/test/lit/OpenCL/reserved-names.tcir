; Java names that mean something in CUDA C++ are renamed by Naming, never rejected: keywords and
; alternative operator tokens (and), functions the emitter calls (max, sqrtf, printf), built-ins
; and types (threadIdx, half, float2), macros (INFINITY), TC's helper namespace (tc_with) and the
; tile alias (ct) get a `_` suffix; names in the underscore namespace (_kernel_context) get a `v`
; prefix; characters C does not allow ($) become `_`; clashes get _1.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int names(int and, int max_, int sqrtf_, int printf_, int threadIdx, int half_, int float2_, int INFINITY_, int tc_with_, int ct, int v_kernel_context, int a_b, int and_)
; CHECK-NEXT:  {
; CHECK-NEXT:    int s1, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, s12;
; CHECK-NEXT:    s1 = and + max_;
; CHECK-NEXT:    s2 = s1 + sqrtf_;
; CHECK-NEXT:    s3 = s2 + printf_;
; CHECK-NEXT:    s4 = s3 + threadIdx;
; CHECK-NEXT:    s5 = s4 + half_;
; CHECK-NEXT:    s6 = s5 + float2_;
; CHECK-NEXT:    s7 = s6 + INFINITY_;
; CHECK-NEXT:    s8 = s7 + tc_with_;
; CHECK-NEXT:    s9 = s8 + ct;
; CHECK-NEXT:    s10 = s9 + v_kernel_context;
; CHECK-NEXT:    s11 = s10 + a_b;
; CHECK-NEXT:    s12 = s11 + and_;
; CHECK-NEXT:    return s12;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @names(%and: i32, %max: i32, %sqrtf: i32, %printf: i32, %threadIdx: i32, %half: i32, %float2: i32, %INFINITY: i32, %tc_with: i32, %ct: i32, %_kernel_context: i32, %a$b: i32, %and_: i32) -> i32 {
^entry:
  %s1 = add %and, %max : i32
  %s2 = add %s1, %sqrtf : i32
  %s3 = add %s2, %printf : i32
  %s4 = add %s3, %threadIdx : i32
  %s5 = add %s4, %half : i32
  %s6 = add %s5, %float2 : i32
  %s7 = add %s6, %INFINITY : i32
  %s8 = add %s7, %tc_with : i32
  %s9 = add %s8, %ct : i32
  %s10 = add %s9, %_kernel_context : i32
  %s11 = add %s10, %a$b : i32
  %s12 = add %s11, %and_ : i32
  ret %s12
}
