; Printing never changes meaning (design review CG-1, CG-2, CG-10):
; - a negated negative operand prints -(-x), not the decrement --x;
; - an operand folded into a spelling template is parenthesised unless it fills a whole call
;   argument: (long long) (i + j) * 2, and x - (i * j);
; - Java byte is signed char (plain char's signedness is implementation-defined).
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static float negneg(int x, float y)
; CHECK-NEXT:  {
; CHECK-NEXT:    return (float) -(-x) + -(-y);
; CHECK-NEXT:  }
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int bytes(__global unsigned char *p)
; CHECK-NEXT:  {
; CHECK-NEXT:    char b;
; CHECK-NEXT:    int w;
; CHECK-NEXT:    b = *((__global char *) p);
; CHECK-NEXT:    w = (int) b;
; CHECK-NEXT:    return w;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: opencl
device @negneg(%x: i32, %y: f32) -> f32 {
^entry:
  %0 = neg %x : i32
  %1 = neg %0 : i32
  %2 = i2f %1 : f32
  %3 = fneg %y : f32
  %4 = fneg %3 : f32
  %5 = fadd %2, %4 : f32
  ret %5
}

device @bytes(%p: ptr<global>) -> i32 {
^entry:
  %b = load %p : i8
  %w = sext %b : i32
  ret %w
}
