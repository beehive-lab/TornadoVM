; A plan with withStrictFloatingPoint() keeps a * b + c as a rounded product and a rounded sum: the
; device compiler must not contract them into fma (S-1). OpenCL C and MSL contract by default; the
; preamble turns it off.
; RUN: tc-emit --target=opencl --no-line-comments --no-contract %s | FileCheck %s
; RUN: tc-emit --target=opencl --no-contract %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-NEXT:  #pragma OPENCL FP_CONTRACT OFF
; CHECK-LABEL: static float muladd(float a, float b, float c)
; CHECK-NEXT:  {
; CHECK-NEXT:    float p, r;
; CHECK-NEXT:    p = a * b;
; CHECK-NEXT:    r = p + c;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @muladd(%a: f32, %b: f32, %c: f32) -> f32 {
^entry:
  %p = fmul %a, %b : f32
  %r = fadd %p, %c : f32
  ret %r
}
