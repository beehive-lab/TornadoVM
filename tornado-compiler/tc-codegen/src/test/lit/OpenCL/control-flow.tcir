; Jumps C cannot express structurally become goto: leaving two loops at once, and restarting an outer
; loop from an inner one; a switch keeps plain breaks.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int search(int n, int key, __global unsigned char *grid)
; CHECK-NEXT:  {
; CHECK-NEXT:    int i, j, ij, idx, v, j1, r;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    for (;;) {
; CHECK-NEXT:      if (i >= n) {
; CHECK-NEXT:        r = -1;
; CHECK-NEXT:        break;
; CHECK-NEXT:      }
; CHECK-NEXT:      j = 0;
; CHECK-NEXT:      while (j < n) {
; CHECK-NEXT:        ij = i * n;
; CHECK-NEXT:        idx = ij + j;
; CHECK-NEXT:        v = *((__global int *) (grid + (long) idx * 4L));
; CHECK-NEXT:        j1 = j + 1;
; CHECK-NEXT:        if (v == key) {
; CHECK-NEXT:          r = idx;
; CHECK-NEXT:          goto L_done;
; CHECK-NEXT:        }
; CHECK-NEXT:        j = j1;
; CHECK-NEXT:      }
; CHECK-NEXT:      i = i + 1;
; CHECK-NEXT:    }
; CHECK-NEXT:    L_done: ;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int pick(int x)
; CHECK-NEXT:  {
; CHECK-NEXT:    int r;
; CHECK-NEXT:    switch (x) {
; CHECK-NEXT:    case 0:
; CHECK-NEXT:      r = 10;
; CHECK-NEXT:      break;
; CHECK-NEXT:    case 1:
; CHECK-NEXT:      r = 20;
; CHECK-NEXT:      break;
; CHECK-NEXT:    default:
; CHECK-NEXT:      r = 30;
; CHECK-NEXT:      break;
; CHECK-NEXT:    }
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int restart(int n)
; CHECK-NEXT:  {
; CHECK-NEXT:    int i, acc, j, i1, acc1;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    acc = 0;
; CHECK-NEXT:    L_outer:
; CHECK-NEXT:    while (i < n) {
; CHECK-NEXT:      j = 0;
; CHECK-NEXT:      while (j < n) {
; CHECK-NEXT:        i1 = i + 1;
; CHECK-NEXT:        acc1 = acc + j;
; CHECK-NEXT:        if (j == i) {
; CHECK-NEXT:          i = i1;
; CHECK-NEXT:          acc = acc1;
; CHECK-NEXT:          goto L_outer;
; CHECK-NEXT:        }
; CHECK-NEXT:        j = j + 1;
; CHECK-NEXT:      }
; CHECK-NEXT:      i = i + 1;
; CHECK-NEXT:    }
; CHECK-NEXT:    return acc;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: opencl
device @search(%n: i32, %key: i32, %grid: ptr<global>) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  %none = const -1 : i32
  br ^outer(%zero)
^outer(%i: i32):
  %oc = icmp.slt %i, %n : i1
  cond_br %oc, ^inner_pre, ^done(%none)
^inner_pre:
  br ^inner(%zero)
^inner(%j: i32):
  %ic = icmp.slt %j, %n : i1
  cond_br %ic, ^probe, ^next_row
^probe:
  %ij = mul %i, %n : i32
  %idx = add %ij, %j : i32
  %wide = sext %idx : i64
  %four = const 4 : i64
  %off = mul %wide, %four : i64
  %p = ptr.offset %grid, %off : ptr<global>
  %v = load %p : i32
  %hit = icmp.eq %v, %key : i1
  %j1 = add %j, %one : i32
  cond_br %hit, ^done(%idx), ^inner(%j1)
^next_row:
  %i1 = add %i, %one : i32
  br ^outer(%i1)
^done(%r: i32):
  ret %r
}

device @pick(%x: i32) -> i32 {
^entry:
  switch %x [0: ^a, 1: ^b] default ^c
^a:
  %ra = const 10 : i32
  br ^join(%ra)
^b:
  %rb = const 20 : i32
  br ^join(%rb)
^c:
  %rc = const 30 : i32
  br ^join(%rc)
^join(%r: i32):
  ret %r
}

; Restarting the outer loop from the inner one: a goto to the outer loop's label.
device @restart(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  br ^outer(%zero, %zero)
^outer(%i: i32, %acc: i32):
  %done = icmp.sge %i, %n : i1
  cond_br %done, ^exit, ^inner_init
^inner_init:
  %z = const 0 : i32
  br ^inner(%z)
^inner(%j: i32):
  %jd = icmp.sge %j, %n : i1
  cond_br %jd, ^after, ^body
^body:
  %eq = icmp.eq %j, %i : i1
  %one = const 1 : i32
  %i1 = add %i, %one : i32
  %acc1 = add %acc, %j : i32
  cond_br %eq, ^outer(%i1, %acc1), ^next
^next:
  %one2 = const 1 : i32
  %j1 = add %j, %one2 : i32
  br ^inner(%j1)
^after:
  %one3 = const 1 : i32
  %i2 = add %i, %one3 : i32
  br ^outer(%i2, %acc)
^exit:
  ret %acc
}
