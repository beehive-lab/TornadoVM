; Debug.printf: every thread prints, prefixed with its global id, as on the Graal path. The format
; is the Java string, an immediate; the CUDA emitter escapes it for C (quotes and control characters
; as octal escapes). The arguments are the varargs values.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static void show(int i, float x)
; CHECK-NEXT:  {
; CHECK-NEXT:    printf("tornado[%3d,%3d,%3d]> value a[%d] = %f \042q\042\n", (int) get_global_id(0), (int) get_global_id(1), (int) get_global_id(2), i, x);
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: opencl
device @show(%i: i32, %x: f32) -> void {
^entry:
  tornado.printf<format = "value a[%d] = %f \"q\"\n">(%i, %x)
  ret
}
