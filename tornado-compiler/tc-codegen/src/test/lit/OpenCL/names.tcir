; Variable names never hide the functions and built-ins the kernel calls: a value named `log` (from
; TornadoMath.log2's local, or a Java local) used next to log() becomes `log_`; so do keywords (codegen Naming).
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static double log2_of(double x, int int_)
; CHECK-NEXT:  {
; CHECK-NEXT:    double log_, lx, q, w, r;
; CHECK-NEXT:    log_ = log(2.0);
; CHECK-NEXT:    lx = log(x);
; CHECK-NEXT:    q = lx / log_;
; CHECK-NEXT:    w = (double) int_;
; CHECK-NEXT:    r = q + w;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @log2_of(%x: f64, %int: i32) -> f64 {
^entry:
  %two = const 2.0 : f64
  %log = math.log(%two) : f64
  %lx = math.log(%x) : f64
  %q = fdiv %lx, %log : f64
  %w = i2f %int : f64
  %r = fadd %q, %w : f64
  ret %r
}
