; A vector at consecutive floats of an array at a byte offset (model frontends: HAT's float4View and
; storeFloat4View). CUDA takes one 64/128-bit access when the address is aligned for it and goes lane by
; lane otherwise (Java allows any element index); OpenCL's vloadn/vstoren need only element alignment.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static float copy4(__global unsigned char *src, __global unsigned char *dst, long from, long to)
; CHECK-NEXT:  {
; CHECK-NEXT:    float4 v;
; CHECK-NEXT:    float2 w;
; CHECK-NEXT:    float first;
; CHECK-NEXT:    v = vload4(0, (__global const float *) ((__global const char *) (src) + (from)));
; CHECK-NEXT:    vstore4(v, 0, (__global float *) ((__global char *) (dst) + (to)));
; CHECK-NEXT:    w = vload2(0, (__global const float *) ((__global const char *) (src) + (to)));
; CHECK-NEXT:    vstore2(w, 0, (__global float *) ((__global char *) (dst) + (from)));
; CHECK-NEXT:    first = v.s0;
; CHECK-NEXT:    return first;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; ---- end of autogenerated checks ----

device @copy4(%src: ptr<global>, %dst: ptr<global>, %from: i64, %to: i64) -> f32 {
^entry:
  %v = tornado.vector.load(%src, %from) : vec<4 x f32>
  tornado.vector.store(%dst, %to, %v)
  %w = tornado.vector.load(%src, %to) : vec<2 x f32>
  tornado.vector.store(%dst, %from, %w)
  %first = tornado.vector.lane<lane = 0>(%v) : f32
  ret %first
}
