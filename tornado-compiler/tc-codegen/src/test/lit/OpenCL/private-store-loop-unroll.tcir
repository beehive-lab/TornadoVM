; A loop that stores into a private array at an address depending on a variable is marked
; `#pragma unroll`: NVIDIA's OpenCL compiler can refuse such a kernel with "unsupported operation"
; (beehive-lab/TornadoVM#1297); unrolled, the addresses are constants. Stores at constant addresses
; (private-array-in-loop.tcir) are left alone.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static short scores(short x)
; CHECK-NEXT:  {
; CHECK-NEXT:    short t[32] = {};
; CHECK-NEXT:    int i;
; CHECK-NEXT:    short v;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    #pragma unroll
; CHECK-NEXT:    while (i < 32) {
; CHECK-NEXT:      t[i] = x;
; CHECK-NEXT:      i = (int) ((uint) i + (uint) 1);
; CHECK-NEXT:    }
; CHECK-NEXT:    v = t[3];
; CHECK-NEXT:    return v;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @scores(%x: i16) -> i16 {
^entry:
  %zero = const 0 : i32
  %n = const 32 : i32
  %t = alloca.private i16[32] : ptr<private>
  br ^head(%zero)
^head(%i: i32):
  %c = icmp.slt %i, %n : i1
  cond_br %c, ^body, ^exit
^body:
  %two = const 2 : i64
  %wide = sext %i : i64
  %off = mul %wide, %two : i64
  %slot = ptr.offset %t, %off : ptr<private>
  store %slot, %x
  %one = const 1 : i32
  %i1 = add %i, %one : i32
  br ^head(%i1)
^exit:
  %six = const 6 : i64
  %third = ptr.offset %t, %six : ptr<private>
  %v = load %third : i16
  ret %v
}
