; A private array allocated inside a loop (`new int[2]` in the body) is zeroed each time the allocation
; executes, not only by the hoisted declaration's `= {}` (TC-1: values leaked across iterations).
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int sum(int n)
; CHECK-NEXT:  {
; CHECK-NEXT:    int t[2] = {};
; CHECK-NEXT:    int i, s, v, v1;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    s = 0;
; CHECK-NEXT:    while (i < n) {
; CHECK-NEXT:      for (int tc_z_ = 0; tc_z_ < 2; tc_z_++) t[tc_z_] = 0;
; CHECK-NEXT:      v = t[0];
; CHECK-NEXT:      v1 = (int) ((uint) v + (uint) i);
; CHECK-NEXT:      t[0] = v1;
; CHECK-NEXT:      s = (int) ((uint) s + (uint) v1);
; CHECK-NEXT:      i = (int) ((uint) i + (uint) 1);
; CHECK-NEXT:    }
; CHECK-NEXT:    return s;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @sum(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  br ^head(%zero, %zero)
^head(%i: i32, %s: i32):
  %c = icmp.slt %i, %n : i1
  cond_br %c, ^body, ^exit
^body:
  %t = alloca.private i32[2] : ptr<private>
  %v = load %t : i32
  %v1 = add %v, %i : i32
  store %t, %v1
  %s1 = add %s, %v1 : i32
  %one = const 1 : i32
  %i1 = add %i, %one : i32
  br ^head(%i1, %s1)
^exit:
  ret %s
}
