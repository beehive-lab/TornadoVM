; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: __kernel void VectorAdd_add(__global long *_kernel_context, __constant uchar *_constant_region, __local uchar *_local_region, __global int *_atomics, __global unsigned char *a, __global unsigned char *b, __global unsigned char *c)
; CHECK-NEXT:  {
; CHECK-NEXT:    int n, s, i;
; CHECK-NEXT:    float x, y, z;
; CHECK-NEXT:    n = (int) *((__global long *) a);
; CHECK-NEXT:    i = (int) get_global_id(0);
; CHECK-NEXT:    s = (int) get_global_size(0);
; CHECK-NEXT:    while (i < n) {
; CHECK-NEXT:      x = *((__global float *) (a + ((long) i * 4L + 16L)));
; CHECK-NEXT:      y = *((__global float *) (b + ((long) i * 4L + 16L)));
; CHECK-NEXT:      z = x + y;
; CHECK-NEXT:      *((__global float *) (c + ((long) i * 4L + 16L))) = z;
; CHECK-NEXT:      i = i + s;
; CHECK-NEXT:    }
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

