; Java semantics in emitted OpenCL C: masked shift counts, logical >>> through an unsigned type, saturating
; float-to-int, NaN-propagating Math.min/max via preamble helpers, special constants, NaN-aware
; comparisons and unsigned integer comparison.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static inline float java_fminf(float a, float b) {
; CHECK-NEXT:    if (isnan(a) || isnan(b)) return as_float(0x7fc00000);
; CHECK-NEXT:    if (a == 0.0f && b == 0.0f) return as_float(as_int(a) | as_int(b));
; CHECK-NEXT:    return a < b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: static inline double java_fmax(double a, double b) {
; CHECK-NEXT:    if (isnan(a) || isnan(b)) return as_double(0x7ff8000000000000L);
; CHECK-NEXT:    if (a == 0.0 && b == 0.0) return as_double(as_long(a) & as_long(b));
; CHECK-NEXT:    return a > b ? a : b;
; CHECK-NEXT:  }
; CHECK-LABEL: static int semantics(int x, int k, long l, float f, double d)
; CHECK-NEXT:  {
; CHECK-NEXT:    int s1, s2, u, fi, bits;
; CHECK-NEXT:    long ul, dl;
; CHECK-NEXT:    float mn;
; CHECK-NEXT:    double mx;
; CHECK-NEXT:    bool lt, ne, ucmp;
; CHECK-NEXT:    s1 = (int) ((uint) x << (k & 31));
; CHECK-NEXT:    s2 = x >> 3;
; CHECK-NEXT:    u = (int) ((uint) x >> (k & 31));
; CHECK-NEXT:    ul = (long) ((ulong) l >> (l & 63));
; CHECK-NEXT:    fi = convert_int_sat_rtz(f);
; CHECK-NEXT:    dl = convert_long_sat_rtz(d);
; CHECK-NEXT:    mn = java_fminf(f, f);
; CHECK-NEXT:    mx = java_fmax(d, d);
; CHECK-NEXT:    lt = !(f >= as_float(0x7fc00000));
; CHECK-NEXT:    ne = f < mn || f > mn;
; CHECK-NEXT:    ucmp = (uint) x < (uint) k;
; CHECK-NEXT:    bits = as_int(f);
; CHECK-NEXT:    return s1;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @semantics(%x: i32, %k: i32, %l: i64, %f: f32, %d: f64) -> i32 {
^entry:
  %s1 = shl %x, %k : i32
  %c35 = const 35 : i32
  %s2 = shr %x, %c35 : i32
  %u = ushr %x, %k : i32
  %ul = ushr %l, %l : i64
  %fi = f2i.sat %f : i32
  %dl = f2i.sat %d : i64
  %mn = math.min(%f, %f) : f32
  %mx = math.max(%d, %d) : f64
  %nan = const nan : f32
  %inf = const -inf : f64
  %min = const -2147483648 : i32
  %lt = fcmp.ult %f, %nan : i1
  %ne = fcmp.one %f, %mn : i1
  %ucmp = icmp.ult %x, %k : i1
  %bits = bitcast %f : i32
  ret %s1
}
