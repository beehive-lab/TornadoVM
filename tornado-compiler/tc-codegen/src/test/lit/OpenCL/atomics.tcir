; KernelContext atomics on array elements and the AtomicInteger region in OpenCL C (warp operations are refused on OpenCL).
; Atomics take the element's address (`&a[i]`, or a typed cast with its address space for a raw
; pointer); long adds use atom_add from cl_khr_int64_base_atomics.
; RUN: tc-emit --target=opencl --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=opencl %s | clbuild
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #pragma OPENCL EXTENSION cl_khr_fp64 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_fp16 : enable
; CHECK-NEXT:  #pragma OPENCL EXTENSION cl_khr_int64_base_atomics : enable
; CHECK-LABEL: static int atomics(__global unsigned char *p, int i, long n)
; CHECK-NEXT:  {
; CHECK-NEXT:    int old;
; CHECK-NEXT:    atomic_add(((__global int *) (p + (long) i * 4L)), i);
; CHECK-NEXT:    atom_add(((__global long *) p), n);
; CHECK-NEXT:    old = atomic_max(((__global int *) (p + (long) i * 4L)), i);
; CHECK-NEXT:    return old;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
; REQUIRES: opencl
device @atomics(%p: ptr<global>, %i: i32, %n: i64) -> i32 {
^entry:
  %four = const 4 : i64
  %wide = sext %i : i64
  %off = mul %wide, %four : i64
  %slot = ptr.offset %p, %off : ptr<global>
  tornado.atomic.add(%slot, %i)
  tornado.atomic.add(%p, %n)
  %old = tornado.atomic.max(%slot, %i) : i32
  ret %old
}
