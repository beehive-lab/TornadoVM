; CHECK-LABEL: __device__ static inline void tc_mma_store(float4 d, float *c, int row, int col, int ld) {
; CHECK-NEXT:    unsigned lane = threadIdx.x & 31u;
; CHECK-NEXT:    int r = row + (int) (lane >> 2), k = col + (int) ((lane & 3u) << 1);
; CHECK-NEXT:    c[r * ld + k] = d.x;
; CHECK-NEXT:    c[r * ld + k + 1] = d.y;
; CHECK-NEXT:    c[(r + 8) * ld + k] = d.z;
; CHECK-NEXT:    c[(r + 8) * ld + k + 1] = d.w;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static float gemm(unsigned char *a, unsigned char *b, unsigned char *c, int row, int col)
; CHECK-NEXT:  {
; CHECK-NEXT:    float4 acc, d;
; CHECK-NEXT:    int4 fa;
; CHECK-NEXT:    int2 fb;
; CHECK-NEXT:    float first;
; CHECK-NEXT:    acc = tc_mma_fragment(0.0f);
; CHECK-NEXT:    fa = tc_mma_load_a((const int *) a, 16, 2);
; CHECK-NEXT:    fb = tc_mma_load_b((const int *) b, 16);
; CHECK-NEXT:    d = tc_mma_m16n8k16(fa, fb, acc);
; CHECK-NEXT:    tc_mma_store(d, (float *) (c), row, col, 64);
; CHECK-NEXT:    first = d.x;
; CHECK-NEXT:    return first;
; CHECK-NEXT:  }
; CHECK-LABEL: #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(float x) { return (__float_as_uint(x) & 0x7fffffffu) > 0x7f800000u; }
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(double x) { return (__double_as_longlong(x) & 0x7fffffffffffffffLL) > 0x7ff0000000000000LL; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(float x) { return tc_isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(double x) { return tc_isnan(x) ? 0 : x >= 2147483647.0 ? 2147483647 : x <= -2147483648.0 ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(float x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807LL : x <= -9223372036854775808.0f ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(double x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0 ? 9223372036854775807LL : x <= -9223372036854775808.0 ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  #endif
; CHECK-LABEL: __device__ static inline int4 tc_mma_load_a_global(const unsigned short *a, int row, int col, int ld) {
; CHECK-NEXT:    unsigned lane = threadIdx.x & 31u;
; CHECK-NEXT:    const unsigned short *p = a + (long long) (row + (int) (lane >> 2)) * ld + col + (int) ((lane & 3u) << 1);
; CHECK-NEXT:    long long down = 8LL * ld;
; CHECK-NEXT:    int4 r;
; CHECK-NEXT:    r.x = *(const int *) p;
; CHECK-NEXT:    r.y = *(const int *) (p + down);
; CHECK-NEXT:    r.z = *(const int *) (p + 8);
; CHECK-NEXT:    r.w = *(const int *) (p + down + 8);
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: // B from global memory: register i holds column col + g of rows row + 8i + 2t and the next one.
; CHECK-NEXT:  __device__ static inline int2 tc_mma_load_b_global(const unsigned short *b, int row, int col, int ld) {
; CHECK-NEXT:    unsigned lane = threadIdx.x & 31u;
; CHECK-NEXT:    long long l = ld;
; CHECK-NEXT:    const unsigned short *p = b + (long long) (row + 2 * (int) (lane & 3u)) * l + col + (int) (lane >> 2);
; CHECK-NEXT:    int2 r;
; CHECK-NEXT:    r.x = (int) (p[0] | ((unsigned) p[l] << 16));
; CHECK-NEXT:    r.y = (int) (p[8 * l] | ((unsigned) p[9 * l] << 16));
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int4 fragments_global(unsigned char *a, unsigned char *b, int row, int col, int ld)
; CHECK-NEXT:  {
; CHECK-NEXT:    int4 fa;
; CHECK-NEXT:    int2 fb;
; CHECK-NEXT:    fa = tc_mma_load_a_global((const unsigned short *) (a), row, col, ld);
; CHECK-NEXT:    fb = tc_mma_load_b_global((const unsigned short *) (b), col, row, ld);
; CHECK-NEXT:    return fa;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @gemm(%a: ptr<shared>, %b: ptr<shared>, %c: ptr<global>, %row: i32, %col: i32) -> f32 {
^entry:
  %zero = const 0.0 : f32
  %k = const 16 : i32
  %ld = const 64 : i32
  %acc = tornado.mma.fragment(%zero) : vec<4 x f32>
  %fa = tornado.mma.load_a(%a, %k) : vec<4 x i32>
  %fb = tornado.mma.load_b(%b, %k) : vec<2 x i32>
  %d = tornado.mma.m16n8k16(%fa, %fb, %acc) : vec<4 x f32>
  tornado.mma.store(%d, %c, %row, %col, %ld)
  %first = tornado.vector.lane<lane = 0>(%d) : f32
  ret %first
}

device @fragments_global(%a: ptr<global>, %b: ptr<global>, %row: i32, %col: i32, %ld: i32) -> vec<4 x i32> {
^entry:
  %fa = tornado.mma.load_a.global(%a, %row, %col, %ld) : vec<4 x i32>
  %fb = tornado.mma.load_b.global(%b, %col, %row, %ld) : vec<2 x i32>
  ret %fa
}
