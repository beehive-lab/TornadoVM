; KernelContext warp operations and atomics: simdSum is a butterfly reduction helper (every lane
; gets the sum), shuffles name a width of 32 lanes and votes read the warp's half of the wavefront's
; ballot, so a 64-wide wavefront behaves as two 32-lane warps; Java booleans stay 0/1. Atomics take
; the element's address (`&a[i]`, or a typed cast for a raw pointer); long adds go through unsigned
; long long, as in CUDA.
; RUN: tc-emit --target=hip --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=hip %s | hiprtccheck
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(float x) { return (__float_as_uint(x) & 0x7fffffffu) > 0x7f800000u; }
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(double x) { return (__double_as_longlong(x) & 0x7fffffffffffffffLL) > 0x7ff0000000000000LL; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(float x) { return tc_isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(double x) { return tc_isnan(x) ? 0 : x >= 2147483647.0 ? 2147483647 : x <= -2147483648.0 ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(float x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807LL : x <= -9223372036854775808.0f ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(double x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0 ? 9223372036854775807LL : x <= -9223372036854775808.0 ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  #endif
; CHECK-LABEL: __device__ static inline float tc_warp_sum(float v) {
; CHECK-NEXT:    for (int lane = 16; lane > 0; lane >>= 1) v += __shfl_xor(v, lane, 32);
; CHECK-NEXT:    return v;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline unsigned tc_warp_bits(unsigned long long ballot) {
; CHECK-NEXT:    return (unsigned) (ballot >> (__lane_id() & 32u));
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static float warp(float v, int p)
; CHECK-NEXT:  {
; CHECK-NEXT:    float s, d, b, f, r;
; CHECK-NEXT:    int any, mask, sum;
; CHECK-NEXT:    s = tc_warp_sum(v);
; CHECK-NEXT:    d = __shfl_down(s, 1, 32);
; CHECK-NEXT:    b = __shfl(d, 0, 32);
; CHECK-NEXT:    any = (tc_warp_bits(__ballot(p)) != 0u);
; CHECK-NEXT:    mask = (int) tc_warp_bits(__ballot(p));
; CHECK-NEXT:    sum = (int) ((unsigned int) any + (unsigned int) mask);
; CHECK-NEXT:    f = (float) sum;
; CHECK-NEXT:    r = b + f;
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; CHECK-LABEL: #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(float x) { return (__float_as_uint(x) & 0x7fffffffu) > 0x7f800000u; }
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(double x) { return (__double_as_longlong(x) & 0x7fffffffffffffffLL) > 0x7ff0000000000000LL; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(float x) { return tc_isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(double x) { return tc_isnan(x) ? 0 : x >= 2147483647.0 ? 2147483647 : x <= -2147483648.0 ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(float x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807LL : x <= -9223372036854775808.0f ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(double x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0 ? 9223372036854775807LL : x <= -9223372036854775808.0 ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  #endif
; CHECK-LABEL: __device__ static int atomics(unsigned char *p, int i, long long n)
; CHECK-NEXT:  {
; CHECK-NEXT:    int old;
; CHECK-NEXT:    atomicAdd(((int *) (p + (long long) ((unsigned long long) (long long) i * (unsigned long long) 4LL))), i);
; CHECK-NEXT:    atomicAdd((unsigned long long *) ((long long *) p), (unsigned long long) n);
; CHECK-NEXT:    old = atomicMax(((int *) (p + (long long) ((unsigned long long) (long long) i * (unsigned long long) 4LL))), i);
; CHECK-NEXT:    return old;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @warp(%v: f32, %p: i32) -> f32 {
^entry:
  %s = tornado.simd.sum(%v) : f32
  %one = const 1 : i32
  %d = tornado.simd.shuffle_down(%s, %one) : f32
  %b = tornado.simd.broadcast_first(%d) : f32
  %any = tornado.simd.any(%p) : i32
  %mask = tornado.simd.ballot(%p) : i32
  %sum = add %any, %mask : i32
  %f = i2f %sum : f32
  %r = fadd %b, %f : f32
  ret %r
}

device @atomics(%p: ptr<global>, %i: i32, %n: i64) -> i32 {
^entry:
  %four = const 4 : i64
  %wide = sext %i : i64
  %off = mul %wide, %four : i64
  %slot = ptr.offset %p, %off : ptr<global>
  tornado.atomic.add(%slot, %i)
  tornado.atomic.add(%p, %n)
  %old = tornado.atomic.max(%slot, %i) : i32
  ret %old
}
