; KernelContext.asyncCopyToLocal: cp.async global-to-shared copies into packed b32 slots of a shared
; int[] tile. The source offset scales by the element size (2 for HalfFloatArray, 1 for byte and FP8
; arrays); the 16-byte form moves four slots at once. On HIP the copy is a plain load and store that
; completes before the copying thread reaches its wait, so commit and wait do nothing.
; RUN: tc-emit --target=hip --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=hip %s | hiprtccheck
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(float x) { return (__float_as_uint(x) & 0x7fffffffu) > 0x7f800000u; }
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(double x) { return (__double_as_longlong(x) & 0x7fffffffffffffffLL) > 0x7ff0000000000000LL; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(float x) { return tc_isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(double x) { return tc_isnan(x) ? 0 : x >= 2147483647.0 ? 2147483647 : x <= -2147483648.0 ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(float x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807LL : x <= -9223372036854775808.0f ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(double x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0 ? 9223372036854775807LL : x <= -9223372036854775808.0 ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  #endif
; CHECK-LABEL: __device__ static inline void tc_cp_async_4(int *dst, const char *src) {
; CHECK-NEXT:    *dst = *(const int *) src;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_cp_async_16(int *dst, const char *src) {
; CHECK-NEXT:    *(int4 *) dst = *(const int4 *) src;
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_cp_async_commit() {
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static inline void tc_cp_async_wait(int n) {
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static void stage(unsigned char *tile, int slot, unsigned char *src, int i)
; CHECK-NEXT:  {
; CHECK-NEXT:    tc_cp_async_4((int *) tile + slot, (const char *) src + (long long) i * 2);
; CHECK-NEXT:    tc_cp_async_16((int *) tile + slot, (const char *) src + (long long) i * 1);
; CHECK-NEXT:    tc_cp_async_commit();
; CHECK-NEXT:    tc_cp_async_wait(0);
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @stage(%tile: ptr<shared>, %slot: i32, %src: ptr<global>, %i: i32) -> void {
^entry:
  tornado.async_copy<bytes = 4, elem_bytes = 2>(%tile, %slot, %src, %i)
  tornado.async_copy<bytes = 16, elem_bytes = 1>(%tile, %slot, %src, %i)
  tornado.async_copy.commit()
  %zero = const 0 : i32
  tornado.async_copy.wait(%zero)
  ret
}
