; QuantizationUtils.dp4a: four signed int8 products accumulated as CUDA's __dp4a does (a helper on HIP). The array forms
; read one 4-byte word at each operand's byte offset (data pointers after ABI lowering, or a local
; byte array); the packed form takes the words directly.
; RUN: tc-emit --target=hip --no-line-comments %s | FileCheck %s
; RUN: tc-emit --target=hip %s | hiprtccheck
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: #ifndef TC_F2I
; CHECK-NEXT:  #define TC_F2I
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(float x) { return (__float_as_uint(x) & 0x7fffffffu) > 0x7f800000u; }
; CHECK-NEXT:  static __device__ __forceinline__ bool tc_isnan(double x) { return (__double_as_longlong(x) & 0x7fffffffffffffffLL) > 0x7ff0000000000000LL; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(float x) { return tc_isnan(x) ? 0 : x >= 2147483647.0f ? 2147483647 : x <= -2147483648.0f ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ int tc_f2i(double x) { return tc_isnan(x) ? 0 : x >= 2147483647.0 ? 2147483647 : x <= -2147483648.0 ? (-2147483647 - 1) : (int) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(float x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0f ? 9223372036854775807LL : x <= -9223372036854775808.0f ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  static __device__ __forceinline__ long long tc_f2l(double x) { return tc_isnan(x) ? 0 : x >= 9223372036854775807.0 ? 9223372036854775807LL : x <= -9223372036854775808.0 ? (-9223372036854775807LL - 1) : (long long) x; }
; CHECK-NEXT:  #endif
; CHECK-LABEL: __device__ static inline int tc_dp4a(int a, int b, int c) {
; CHECK-NEXT:    return c + (int) (signed char) a * (int) (signed char) b + (int) (signed char) (a >> 8) * (int) (signed char) (b >> 8)
; CHECK-NEXT:        + (int) (signed char) (a >> 16) * (int) (signed char) (b >> 16) + (int) (a >> 24) * (int) (b >> 24);
; CHECK-NEXT:  }
; CHECK-LABEL: __device__ static int dot(unsigned char *a, long long oa, unsigned char *b, long long ob, int c, int x, int y)
; CHECK-NEXT:  {
; CHECK-NEXT:    int d, p;
; CHECK-NEXT:    d = tc_dp4a(*((const int *) ((const char *) a + oa)), *((const int *) ((const char *) b + ob)), c);
; CHECK-NEXT:    p = tc_dp4a(x, y, d);
; CHECK-NEXT:    return p;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----
device @dot(%a: ptr<global>, %oa: i64, %b: ptr<shared>, %ob: i64, %c: i32, %x: i32, %y: i32) -> i32 {
^entry:
  %d = tornado.dp4a(%a, %oa, %b, %ob, %c) : i32
  %p = tornado.dp4a.packed(%x, %y, %d) : i32
  ret %p
}
