device @negneg(%x: i32, %y: f32) -> f32 {
^entry:
  %0 = neg %x : i32
  %1 = neg %0 : i32
  %2 = i2f %1 : f32
  %3 = fneg %y : f32
  %4 = fneg %3 : f32
  %5 = fadd %2, %4 : f32
  ret %5
}

kernel @cpasync(%tile: ptr<global>, %slot: i32, %src: ptr<global>, %i: i32, %j: i32, %out: ptr<global>) -> void {
^entry:
  %0 = add %i, %j : i32
  tornado.async_copy<bytes = 4, elem_bytes = 2>(%tile, %slot, %src, %0)
  %c = const 3 : i32
  %1 = mul %i, %j : i32
  %2 = tornado.atomic_int.sub_get(%c, %1) : i32
  %3 = mul %2, %i : i32
  store %out, %3
  ret
}

device @bytes(%p: ptr<global>) -> i32 {
^entry:
  %b = load %p : i8
  %w = sext %b : i32
  ret %w
}
