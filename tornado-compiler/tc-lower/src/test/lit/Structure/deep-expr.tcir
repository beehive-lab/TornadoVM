; CHECK-NEXT:    v65 = (((((((((((((((((((((((((((((((((v32 + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y) + y);
; CHECK-NEXT:    return ((((v65 + y) + y) + y) + y);
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @chain(%x: f32, %y: f32) -> f32 {
^entry:
  %1 = fadd %x, %y : f32
  %2 = fadd %1, %y : f32
  %3 = fadd %2, %y : f32
