; Diamonds become if/else with the merge value in a variable; an empty arm is dropped.
; RUN: tc-lower %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device diamond(i1 c, i32 a, i32 b) -> i32 {
; CHECK-NEXT:    i32 r;
; CHECK-NEXT:    if (c) {
; CHECK-NEXT:      r = (a + b);
; CHECK-NEXT:    } else {
; CHECK-NEXT:      r = (a * b);
; CHECK-NEXT:    }
; CHECK-NEXT:    return (r + 1);
; CHECK-NEXT:  }
; CHECK-LABEL: device if_no_else(i1 c, ptr<global> p, f32 v) -> void {
; CHECK-NEXT:    if (c) {
; CHECK-NEXT:      store(p, v);
; CHECK-NEXT:    }
; CHECK-NEXT:    return;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @diamond(%c: i1, %a: i32, %b: i32) -> i32 {
^entry:
  cond_br %c, ^then, ^else
^then:
  %x = add %a, %b : i32
  br ^join(%x)
^else:
  %y = mul %a, %b : i32
  br ^join(%y)
^join(%r: i32):
  %one = const 1 : i32
  %s = add %r, %one : i32
  ret %s
}

device @if_no_else(%c: i1, %p: ptr<global>, %v: f32) -> void {
^entry:
  cond_br %c, ^then, ^join
^then:
  store %p, %v
  br ^join
^join:
  ret
}
