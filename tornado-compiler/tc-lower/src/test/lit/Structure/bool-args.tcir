; A condition passed to a block argument by a plain branch (Babylon lowers `a && b` this way): the
; branch has no condition operand, so the condition is a variable, not inlined into an `if`.
; RUN: tc-lower %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device andand(i32 a, i32 b) -> i32 {
; CHECK-NEXT:    i1 lt;
; CHECK-NEXT:    i1 both;
; CHECK-NEXT:    lt = (a slt b);
; CHECK-NEXT:    if (lt) {
; CHECK-NEXT:      both = (a sgt 0);
; CHECK-NEXT:    } else {
; CHECK-NEXT:      both = lt;
; CHECK-NEXT:    }
; CHECK-NEXT:    if (both) {
; CHECK-NEXT:      return a;
; CHECK-NEXT:    } else {
; CHECK-NEXT:      return b;
; CHECK-NEXT:    }
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @andand(%a: i32, %b: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  %lt = icmp.slt %a, %b : i1
  cond_br %lt, ^rhs, ^join(%lt)
^rhs:
  %gt = icmp.sgt %a, %zero : i1
  br ^join(%gt)
^join(%both: i1):
  cond_br %both, ^yes, ^no
^yes:
  ret %a
^no:
  ret %b
}
