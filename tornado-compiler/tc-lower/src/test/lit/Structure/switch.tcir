; A switch whose cases share a target jumps to one labelled block for them.
; RUN: tc-lower %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device classify(i32 x) -> i32 {
; CHECK-NEXT:    i32 r;
; CHECK-NEXT:    block L_join {
; CHECK-NEXT:      block L_one {
; CHECK-NEXT:        switch (x) {
; CHECK-NEXT:        case 0:
; CHECK-NEXT:          r = 10;
; CHECK-NEXT:          break L_join;
; CHECK-NEXT:        case 1:
; CHECK-NEXT:          break L_one;
; CHECK-NEXT:        case 2:
; CHECK-NEXT:          break L_one;
; CHECK-NEXT:        default:
; CHECK-NEXT:          r = 30;
; CHECK-NEXT:          break L_join;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:      r = 20;
; CHECK-NEXT:    }
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @classify(%x: i32) -> i32 {
^entry:
  switch %x [0: ^zero, 1: ^one, 2: ^one] default ^other
^zero:
  %z = const 10 : i32
  br ^join(%z)
^one:
  %o = const 20 : i32
  br ^join(%o)
^other:
  %t = const 30 : i32
  br ^join(%t)
^join(%r: i32):
  ret %r
}
