; Block arguments become variables assigned on each edge; interfering copies (a swap, Fibonacci)
; are sequenced with a single temporary.
; RUN: tc-lower %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: device swap(i32 n) -> i32 {
; CHECK-NEXT:    i32 a;
; CHECK-NEXT:    i32 b;
; CHECK-NEXT:    i32 i;
; CHECK-NEXT:    i32 tmp0;
; CHECK-NEXT:    a = 0;
; CHECK-NEXT:    b = 1;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    block L_exit {
; CHECK-NEXT:      loop L_head {
; CHECK-NEXT:        if ((i slt n)) {
; CHECK-NEXT:          i = (i + 1);
; CHECK-NEXT:          tmp0 = a;
; CHECK-NEXT:          a = b;
; CHECK-NEXT:          b = tmp0;
; CHECK-NEXT:        } else {
; CHECK-NEXT:          break L_exit;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    return a;
; CHECK-NEXT:  }
; CHECK-LABEL: device fib(i32 n) -> i32 {
; CHECK-NEXT:    i32 a;
; CHECK-NEXT:    i32 b;
; CHECK-NEXT:    i32 i;
; CHECK-NEXT:    i32 sum;
; CHECK-NEXT:    a = 0;
; CHECK-NEXT:    b = 1;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    block L_exit {
; CHECK-NEXT:      loop L_head {
; CHECK-NEXT:        if ((i slt n)) {
; CHECK-NEXT:          sum = (a + b);
; CHECK-NEXT:          i = (i + 1);
; CHECK-NEXT:          a = b;
; CHECK-NEXT:          b = sum;
; CHECK-NEXT:        } else {
; CHECK-NEXT:          break L_exit;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    return a;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

device @swap(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  br ^head(%zero, %one, %zero)
^head(%a: i32, %b: i32, %i: i32):
  %more = icmp.slt %i, %n : i1
  cond_br %more, ^body, ^exit
^body:
  %i1 = add %i, %one : i32
  br ^head(%b, %a, %i1)
^exit:
  ret %a
}

device @fib(%n: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  br ^head(%zero, %one, %zero)
^head(%a: i32, %b: i32, %i: i32):
  %more = icmp.slt %i, %n : i1
  cond_br %more, ^body, ^exit
^body:
  %sum = add %a, %b : i32
  %i1 = add %i, %one : i32
  br ^head(%b, %sum, %i1)
^exit:
  ret %a
}
