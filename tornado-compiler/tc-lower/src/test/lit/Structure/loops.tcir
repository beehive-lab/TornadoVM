; Loops: a while-style loop exits with a break to the block after it, nested loops nest, and an
; early exit from inside the body breaks to the shared exit block.
; RUN: tc-lower %s | FileCheck %s
; ---- autogenerated by utils/update-checks.py; edit with care ----
; CHECK-LABEL: kernel vadd(array<f32> a, array<f32> b, array<f32> c) -> void {
; CHECK-NEXT:    i32 n;
; CHECK-NEXT:    i32 s;
; CHECK-NEXT:    i32 i;
; CHECK-NEXT:    f32 x;
; CHECK-NEXT:    f32 y;
; CHECK-NEXT:    f32 z;
; CHECK-NEXT:    n = array.length(c);
; CHECK-NEXT:    i = tornado.thread_id.global.x();
; CHECK-NEXT:    s = tornado.global_size.x();
; CHECK-NEXT:    block L_exit {
; CHECK-NEXT:      loop L_head {
; CHECK-NEXT:        if ((i slt n)) {
; CHECK-NEXT:          x = a[i];
; CHECK-NEXT:          y = b[i];
; CHECK-NEXT:          z = (x + y);
; CHECK-NEXT:          c[i] = z;
; CHECK-NEXT:          i = (i + s);
; CHECK-NEXT:        } else {
; CHECK-NEXT:          break L_exit;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    return;
; CHECK-NEXT:  }
; CHECK-LABEL: device nested(i32 n, i32 m, array<i32> out) -> void {
; CHECK-NEXT:    i32 i;
; CHECK-NEXT:    i32 j;
; CHECK-NEXT:    i32 v;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    block L_done {
; CHECK-NEXT:      loop L_outer {
; CHECK-NEXT:        if ((i slt n)) {
; CHECK-NEXT:          j = 0;
; CHECK-NEXT:          block L_inner_done {
; CHECK-NEXT:            loop L_inner {
; CHECK-NEXT:              if ((j slt m)) {
; CHECK-NEXT:                v = (i + j);
; CHECK-NEXT:                out[j] = v;
; CHECK-NEXT:                j = (j + 1);
; CHECK-NEXT:              } else {
; CHECK-NEXT:                break L_inner_done;
; CHECK-NEXT:              }
; CHECK-NEXT:            }
; CHECK-NEXT:          }
; CHECK-NEXT:          i = (i + 1);
; CHECK-NEXT:        } else {
; CHECK-NEXT:          break L_done;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    return;
; CHECK-NEXT:  }
; CHECK-LABEL: device early_exit(i32 n, array<i32> a, i32 key) -> i32 {
; CHECK-NEXT:    i32 i;
; CHECK-NEXT:    i32 v;
; CHECK-NEXT:    i32 next;
; CHECK-NEXT:    i32 r;
; CHECK-NEXT:    i = 0;
; CHECK-NEXT:    block L_notfound {
; CHECK-NEXT:      loop L_head {
; CHECK-NEXT:        if ((i slt n)) {
; CHECK-NEXT:          v = a[i];
; CHECK-NEXT:          next = (i + 1);
; CHECK-NEXT:          if ((v eq key)) {
; CHECK-NEXT:            r = i;
; CHECK-NEXT:            break L_notfound;
; CHECK-NEXT:          } else {
; CHECK-NEXT:            i = next;
; CHECK-NEXT:          }
; CHECK-NEXT:        } else {
; CHECK-NEXT:          r = -1;
; CHECK-NEXT:          break L_notfound;
; CHECK-NEXT:        }
; CHECK-NEXT:      }
; CHECK-NEXT:    }
; CHECK-NEXT:    return r;
; CHECK-NEXT:  }
; ---- end of autogenerated checks ----

kernel @vadd(%a: array<f32>, %b: array<f32>, %c: array<f32>) -> void {
^entry:
  %n = array.length %c : i32
  %i0 = tornado.thread_id.global.x() : i32
  %s = tornado.global_size.x() : i32
  br ^head(%i0)
^head(%i: i32):
  %more = icmp.slt %i, %n : i1
  cond_br %more, ^body, ^exit
^body:
  %x = array.load %a[%i] : f32
  %y = array.load %b[%i] : f32
  %z = fadd %x, %y : f32
  array.store %c[%i], %z
  %next = add %i, %s : i32
  br ^head(%next)
^exit:
  ret
}

device @nested(%n: i32, %m: i32, %out: array<i32>) -> void {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  br ^outer(%zero)
^outer(%i: i32):
  %oc = icmp.slt %i, %n : i1
  cond_br %oc, ^inner_pre, ^done
^inner_pre:
  br ^inner(%zero)
^inner(%j: i32):
  %ic = icmp.slt %j, %m : i1
  cond_br %ic, ^inner_body, ^inner_done
^inner_body:
  %v = add %i, %j : i32
  array.store %out[%j], %v
  %j1 = add %j, %one : i32
  br ^inner(%j1)
^inner_done:
  %i1 = add %i, %one : i32
  br ^outer(%i1)
^done:
  ret
}

device @early_exit(%n: i32, %a: array<i32>, %key: i32) -> i32 {
^entry:
  %zero = const 0 : i32
  %one = const 1 : i32
  %minus = const -1 : i32
  br ^head(%zero)
^head(%i: i32):
  %more = icmp.slt %i, %n : i1
  cond_br %more, ^body, ^notfound(%minus)
^body:
  %v = array.load %a[%i] : i32
  %hit = icmp.eq %v, %key : i1
  %next = add %i, %one : i32
  cond_br %hit, ^notfound(%i), ^head(%next)
^notfound(%r: i32):
  ret %r
}
